const STAGES=["Backlog","A fazer","Em andamento","Em validação","Concluído"];
let areaPeriod="week";
let currentRoute="overview";
let kanbanArea="all";
let currentModalTask=null;
let lastFocus=null;

/* ==========================================================
   HELPERS
   ========================================================== */
const $=(s,c=document)=>c.querySelector(s);
const $$=(s,c=document)=>[...c.querySelectorAll(s)];
const sum=a=>a.reduce((x,y)=>x+y,0);
const avg=a=>a.length?sum(a)/a.length:0;
const esc=v=>String(v).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]));
const priorityLabel=p=>p==="high"?"Alta":p==="medium"?"Média":"Baixa";
const priorityClass=p=>p==="high"?"":p==="medium"?"medium":"low";
const initials=name=>name.split(" ").slice(0,2).map(x=>x[0]).join("").toUpperCase();

function toast(msg){
  const el=document.createElement("div");el.className="toast";el.textContent=msg;$("#toasts").appendChild(el);
  setTimeout(()=>{el.style.opacity="0";el.style.transform="translateX(12px)"},2300);
  setTimeout(()=>el.remove(),2650);
}

function statusLabel(task){
  if(task.stage==="Concluído")return["Concluído","st-done"];
  if(task.status==="late")return["Atrasado","st-late"];
  if(task.stage==="Em andamento"||task.stage==="Em validação")return["Em andamento","st-progress"];
  return["Pendente","st-pending"];
}

/* ==========================================================
   ROUTER
   ========================================================== */
function navigate(route,push=true){
  const valid=["overview","kanban","areas","indicators","risks"];
  currentRoute=valid.includes(route)?route:"overview";
  $$(".page").forEach(p=>p.classList.toggle("active",p.dataset.page===currentRoute));
  $$(".tab").forEach(t=>{
    const active=t.dataset.route===currentRoute;
    t.classList.toggle("active",active);
    if(active)t.setAttribute("aria-current","page");
    else t.removeAttribute("aria-current");
  });
  if(push)history.pushState({route:currentRoute},"",`#/${currentRoute}`);
  renderRoute();
  window.scrollTo({top:0,behavior:"auto"});
}
document.addEventListener("click",e=>{
  const route=e.target.closest("[data-route]");
  if(route){e.preventDefault();navigate(route.dataset.route)}
});
window.addEventListener("popstate",()=>navigate(location.hash.replace("#/","")||"overview",false));
function renderRoute(){
  if(currentRoute==="overview")renderOverview();
  if(currentRoute==="kanban")renderKanban();
  if(currentRoute==="areas")renderAreas();
  if(currentRoute==="indicators")renderIndicators();
  if(currentRoute==="risks")renderRisks();
}

/* ==========================================================
   OVERVIEW
   ========================================================== */
function renderOverview(){
  const month=AREA_STATS.month,total=150;
  const done=sum(Object.values(month).map(x=>x.done));
  const pending=sum(Object.values(month).map(x=>x.pending));
  const late=sum(Object.values(month).map(x=>x.late));
  const onTime=Math.round(done/(done+late)*100);
  const kpis=[
    ["Tarefas no mês","150","+12 vs. mês anterior","▣","#edf2fb","#3e63b3","rgba(99,134,215,.08)"],
    ["Concluídas",done,Math.round(done/total*100)+"% do total","✓","#edf6f1","#39795f","rgba(90,162,128,.08)"],
    ["Pendentes",pending,"em fila ou execução","…","#f8f2e5","#8c6828","rgba(213,167,85,.08)"],
    ["Atrasadas",late,late+" exigem atenção","!","#f8e9ec","#994757","rgba(204,114,131,.08)"],
    ["Entregas no prazo",onTime+"%","+3 p.p. no período","↗","#edf3fb","#3e63b3","rgba(99,134,215,.08)"]
  ];
  $("#overviewKpis").innerHTML=kpis.map(([l,v,s,icon,bg,fg,glow])=>`
    <article class="kpi" style="--icon-bg:${bg};--icon-fg:${fg};--glow:${glow}">
      <div class="kpi-top"><span class="kpi-label">${l}</span><span class="kpi-icon">${icon}</span></div>
      <strong>${v}</strong><small>${s}</small>
    </article>`).join("");

  const planned=[36,39,38,41],completed=[32,36,34,38],weeks=["Sem 1","Sem 2","Sem 3","Sem 4"];
  $("#overviewDelivery").innerHTML=`<div class="bar-list" role="img" aria-label="Tarefas planejadas e concluídas nas quatro semanas do mês">${weeks.map((w,i)=>`<div class="bar-row"><label>${w}</label><div class="bar-track"><i class="bar-plan" style="width:${planned[i]/45*100}%"></i><i class="bar-real" style="width:${completed[i]/45*100}%;animation-delay:${i*.08}s"></i></div><strong>${completed[i]}</strong></div>`).join("")}</div>`;

  renderDonut("#overviewDonut",done,pending,late,total);

  const ranked=Object.entries(month).sort((a,b)=>b[1].total-a[1].total).slice(0,5);
  $("#topAreas").innerHTML=ranked.map(([a,d])=>`<div class="rank-row"><label>${a}</label><div class="bar-track"><i class="bar-real" style="width:${d.total/25*100}%;background:linear-gradient(90deg,${AREAS[a].color},#91c3c4)"></i></div><strong>${d.total}</strong></div>`).join("");

  const upcoming=[...tasks].filter(t=>t.stage!=="Concluído").slice(0,6);
  $("#nextDeliveries").innerHTML=upcoming.map(t=>{
    const [label,cls]=statusLabel(t);
    return `<div class="data-row" data-task-open="${t.id}" style="cursor:pointer"><div class="row-title"><b>${t.title}</b><span>${t.key} · ${t.area}</span></div><div><span class="status ${cls}">${label}</span></div><div class="progress-cell"><div class="progress"><div class="track"><i class="fill" style="width:${Math.min(90,35+t.id*3)}%"></i></div><span>${Math.min(90,35+t.id*3)}%</span></div></div><div class="extra-cell"><strong style="font-size:7px">${t.due}</strong></div><div class="owner-cell"><span class="mini-avatar">${t.assignee}</span></div></div>`;
  }).join("");
  bindTaskRows();
}

function renderDonut(selector,done,pending,late,total){
  let a=0;
  const parts=[["var(--green)",done],["var(--amber)",pending],["var(--rose)",late]];
  const grad=parts.map(([color,v])=>{const s=a;a+=v/total*100;return `${color} ${s}% ${a}%`}).join(",");
  $(selector).innerHTML=`<div class="donut-layout"><div class="donut" style="background:conic-gradient(${grad})"><div class="donut-center"><strong>${total}</strong><span>tarefas</span></div></div><div class="donut-legend">
    <div class="d-row"><span><i class="dot" style="background:var(--green)"></i>Concluídas</span><strong>${done}</strong></div>
    <div class="d-row"><span><i class="dot" style="background:var(--amber)"></i>Pendentes</span><strong>${pending}</strong></div>
    <div class="d-row"><span><i class="dot" style="background:var(--rose)"></i>Atrasadas</span><strong>${late}</strong></div>
  </div></div>`;
}

/* ==========================================================
   KANBAN
   ========================================================== */
function initKanbanFilter(){
  $("#kanbanAreaFilter").innerHTML=`<option value="all">Todas as áreas</option>`+Object.keys(AREAS).map(a=>`<option>${a}</option>`).join("");
  $("#kanbanAreaFilter").addEventListener("change",e=>{kanbanArea=e.target.value;renderKanban()});
}
function renderKanban(){
  const list=kanbanArea==="all"?tasks:tasks.filter(t=>t.area===kanbanArea);
  $("#kanbanBoard").innerHTML=STAGES.map(stage=>{
    const cards=list.filter(t=>t.stage===stage);
    return `<section class="kanban-col" data-stage="${stage}"><div class="col-head"><strong>${stage}</strong><span class="count">${cards.length}</span></div><div class="kanban-cards">${cards.map(kanbanCard).join("")}</div></section>`;
  }).join("");

  let dragging=false;
  $$(".kanban-card").forEach(card=>{
    card.addEventListener("dragstart",()=>{dragging=true;card.classList.add("dragging")});
    card.addEventListener("dragend",()=>{card.classList.remove("dragging");setTimeout(()=>dragging=false,80)});
    card.addEventListener("click",()=>{if(!dragging)openTask(+card.dataset.id)});
    card.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();openTask(+card.dataset.id)}});
    const stageSelect=$(".mobile-stage",card);
    if(stageSelect){
      stageSelect.addEventListener("click",e=>e.stopPropagation());
      stageSelect.addEventListener("change",e=>{moveTask(+card.dataset.id,e.target.value)});
    }
  });
  $$(".kanban-col").forEach(col=>{
    col.addEventListener("dragover",e=>e.preventDefault());
    col.addEventListener("drop",e=>{
      e.preventDefault();
      const card=$(".kanban-card.dragging");
      if(card)moveTask(+card.dataset.id,col.dataset.stage);
    });
  });
}
function kanbanCard(t){
  const person=PEOPLE[t.assignee];
  return `<article class="kanban-card" draggable="true" tabindex="0" role="button" aria-label="Abrir ${t.title}" data-id="${t.id}">
    <div class="k-top"><span class="task-key">${t.key}</span><i class="priority-dot ${t.priority}"></i></div>
    <h4>${t.title}</h4><p>${t.area} · ${t.squad}</p>
    <div class="k-tags"><span class="tag">${priorityLabel(t.priority)}</span><span class="tag">${t.points} pts</span></div>
    <div class="k-foot"><span class="mini-avatar" title="${person.name}">${t.assignee}</span><span class="due">${t.due}</span></div>
    <select class="mobile-stage" aria-label="Mover tarefa">${STAGES.map(s=>`<option ${s===t.stage?"selected":""}>${s}</option>`).join("")}</select>
  </article>`;
}
function moveTask(id,stage){
  const t=tasks.find(x=>x.id===id);if(!t)return;t.stage=stage;
  if(stage==="Concluído")t.status="done";
  else if(t.status==="done")t.status="pending";
  toast(`${t.key} movida para ${stage}.`);renderKanban();
}
$("#addDemoTask").addEventListener("click",()=>{
  const id=Math.max(...tasks.map(t=>t.id))+1;
  tasks.push({id,key:`DATA-${141+id}`,title:"Nova tarefa demonstrativa",area:kanbanArea==="all"?"Comercial":kanbanArea,stage:"Backlog",status:"pending",priority:"low",assignee:"MC",reporter:"AN",squad:"Squad BI & Relatórios",due:"A definir",created:"Hoje",updated:"Agora",points:3,labels:["Demo"],description:"Tarefa criada localmente para demonstrar o comportamento do Kanban.",acceptance:["Revisar contexto","Definir responsável"],checklist:[["Revisar contexto",false],["Definir próximo passo",false]],comments:[],activity:["Tarefa demonstrativa criada"]});
  toast("Tarefa fictícia adicionada ao Backlog.");renderKanban();
});

/* ==========================================================
   JIRA-LIKE MODAL
   ========================================================== */
function openTask(id){
  const t=tasks.find(x=>x.id===id);if(!t)return;
  currentModalTask=t;lastFocus=document.activeElement;
  $("#modalTaskKey").innerHTML=`<span>▣</span><span>${t.key}</span><span>·</span><span>${t.area}</span>`;
  $("#modalTaskTitle").textContent=t.title;
  renderTaskModal();
  $("#taskModalScrim").classList.add("open");$("#taskModalScrim").setAttribute("aria-hidden","false");document.body.classList.add("lock");$("#taskModalClose").focus();
}
function renderTaskModal(){
  const t=currentModalTask;if(!t)return;
  const assignee=PEOPLE[t.assignee],reporter=PEOPLE[t.reporter];
  $("#taskModalContent").innerHTML=`<div class="task-layout">
    <div class="task-main">
      <section class="jira-section"><h3>Descrição</h3><div class="description-box"><p>${esc(t.description)}</p></div></section>

      <section class="jira-section"><h3>Critérios de aceite</h3><div class="description-box"><ul class="criteria-list">${t.acceptance.map(x=>`<li>${esc(x)}</li>`).join("")}</ul></div></section>

      <section class="jira-section"><h3>Checklist</h3><div class="description-box"><div class="checklist">${t.checklist.map((x,i)=>`<label class="check-item"><input type="checkbox" data-check-index="${i}" ${x[1]?"checked":""}><span>${esc(x[0])}</span></label>`).join("")}</div></div></section>

      <section class="jira-section"><h3>Comentários</h3>
        <div class="comment-list">${t.comments.length?t.comments.map(commentHtml).join(""):`<div style="color:var(--muted);font-size:7px">Nenhum comentário ainda.</div>`}</div>
        <form id="commentForm" class="comment-form"><label class="sr-only" for="commentInput">Adicionar comentário</label><input id="commentInput" class="comment-input" aria-label="Adicionar comentário" placeholder="Adicionar comentário..."><button class="comment-submit" type="submit">Comentar</button></form>
      </section>
    </div>

    <aside class="task-side">
      <section class="side-section"><h3>Detalhes</h3><div class="detail-list">
        <div class="detail-row"><label for="modalStageSelect">Status</label><select id="modalStageSelect" class="detail-select" aria-label="Alterar status da tarefa">${STAGES.map(s=>`<option ${s===t.stage?"selected":""}>${s}</option>`).join("")}</select></div>
        <div class="detail-row"><span>Responsável</span><div class="user-chip"><span class="mini-avatar">${t.assignee}</span><strong>${assignee.name}</strong></div></div>
        <div class="detail-row"><span>Reporter</span><div class="user-chip"><span class="mini-avatar">${t.reporter}</span><strong>${reporter.name}</strong></div></div>
        <div class="detail-row"><span>Prioridade</span><strong><span class="priority-chip ${priorityClass(t.priority)}">${priorityLabel(t.priority)}</span></strong></div>
        <div class="detail-row"><span>Squad</span><strong>${t.squad}</strong></div>
        <div class="detail-row"><span>Área</span><strong>${t.area}</strong></div>
        <div class="detail-row"><span>Prazo</span><strong>${t.due}</strong></div>
        <div class="detail-row"><span>Story points</span><strong>${t.points}</strong></div>
      </div></section>

      <section class="side-section"><h3>Labels</h3><div class="label-row">${t.labels.map(l=>`<span class="label">${esc(l)}</span>`).join("")}</div></section>

      <section class="side-section"><h3>Datas</h3><div class="detail-list">
        <div class="detail-row"><span>Criada</span><strong>${t.created}</strong></div>
        <div class="detail-row"><span>Atualizada</span><strong>${t.updated}</strong></div>
      </div></section>

      <section class="side-section"><h3>Atividade</h3><div class="activity">${t.activity.map(a=>`<div class="activity-item"><strong>${esc(a)}</strong></div>`).join("")}</div></section>
    </aside>
  </div>`;

  const modalStageSelect=$("#modalStageSelect");
  if(modalStageSelect){
    modalStageSelect.addEventListener("change",()=>{
      const previous=t.stage;
      t.stage=modalStageSelect.value;
      if(t.stage==="Concluído")t.status="done";
      else if(t.status==="done")t.status="pending";
      t.updated="Agora";
      t.activity.unshift(`Status alterado de ${previous} para ${t.stage}`);
      toast(`${t.key}: status alterado para ${t.stage}.`);
      if(currentRoute==="kanban") renderKanban();
      renderTaskModal();
    });
  }

  $$("[data-check-index]",$("#taskModalContent")).forEach(box=>box.addEventListener("change",()=>{
    t.checklist[+box.dataset.checkIndex][1]=box.checked;
  }));
  $("#commentForm").addEventListener("submit",e=>{
    e.preventDefault();const input=$("#commentInput");const text=input.value.trim();if(!text)return;
    t.comments.push({by:"MC",when:"Agora",text});t.activity.unshift("Marina Costa adicionou um comentário");renderTaskModal();toast("Comentário adicionado localmente.");
  });
}
function commentHtml(c){
  const person=PEOPLE[c.by]||{name:c.by};
  return `<div class="comment"><span class="comment-avatar">${c.by}</span><div class="comment-body"><strong>${person.name}</strong><time>${c.when}</time><p>${esc(c.text)}</p></div></div>`;
}
function closeTask(){
  $("#taskModalScrim").classList.remove("open");$("#taskModalScrim").setAttribute("aria-hidden","true");document.body.classList.remove("lock");lastFocus?.focus?.();
}
$("#taskModalClose").addEventListener("click",closeTask);
$("#taskModalScrim").addEventListener("click",e=>{if(e.target===$("#taskModalScrim"))closeTask()});
$("#copyLinkBtn").addEventListener("click",()=>{if(currentModalTask){navigator.clipboard?.writeText(currentModalTask.key).catch(()=>{});toast(`Referência ${currentModalTask.key} copiada.`)}});
document.addEventListener("keydown",e=>{
  if(e.key==="Escape"&&$("#taskModalScrim").classList.contains("open"))closeTask();
  if(e.key==="Tab"&&$("#taskModalScrim").classList.contains("open")){
    const focusables=$$('button,[href],input,select,textarea,[tabindex]:not([tabindex="-1"])',$("#taskModal")).filter(x=>!x.disabled);
    if(!focusables.length)return;
    const first=focusables[0],last=focusables[focusables.length-1];
    if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}
    else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}
  }
});
function bindTaskRows(){$$("[data-task-open]").forEach(r=>r.addEventListener("click",()=>openTask(+r.dataset.taskOpen)))}

/* ==========================================================
   AREAS
   ========================================================== */
function renderAreas(){
  const stats=AREA_STATS[areaPeriod],vals=Object.values(stats);
  const total=sum(vals.map(x=>x.total)),done=sum(vals.map(x=>x.done)),pending=sum(vals.map(x=>x.pending)),late=sum(vals.map(x=>x.late));
  $("#areaDistributionLabel").textContent=`${total} tarefas ${areaPeriod==="week"?"na semana":"no mês"}`;
  $("#areaSummary").innerHTML=[
    ["Total de tarefas",total,areaPeriod==="week"?"nesta semana":"neste mês"],
    ["Concluídas",done,Math.round(done/total*100)+"% do total"],
    ["Pendentes",pending,"aguardando ou em andamento"],
    ["Atrasadas",late,"exigem acompanhamento"]
  ].map(([l,v,s])=>`<article class="summary-card"><span>${l}</span><strong>${v}</strong><span>${s}</span></article>`).join("");

  $("#areaGrid").innerHTML=Object.entries(stats).map(([a,d])=>`
    <article class="area-card" aria-label="${a}: ${d.total} tarefas, ${d.done} concluídas, ${d.pending} pendentes e ${d.late} atrasadas" style="--area:${AREAS[a].color};--area-soft:${AREAS[a].soft}">
      <div class="area-icon">${AREAS[a].icon}</div><h3>${a}</h3><p>Tarefas atendidas pela área no período selecionado.</p>
      <div class="area-total"><strong>${d.total}</strong><span>tarefas</span></div>
      <div class="area-status"><div><strong>${d.done}</strong><span>concl.</span></div><div><strong>${d.pending}</strong><span>pend.</span></div><div><strong>${d.late}</strong><span>atras.</span></div></div>
      <div class="stackbar" aria-label="${d.done} concluídas, ${d.pending} pendentes e ${d.late} atrasadas"><i class="done" style="width:${d.done/d.total*100}%"></i><i class="pending" style="width:${d.pending/d.total*100}%"></i><i class="late" style="width:${d.late/d.total*100}%"></i></div>
    </article>`).join("");

  renderAreaComparison();

  const ranked=Object.entries(stats).sort((a,b)=>b[1].total-a[1].total);
  const max=Math.max(...ranked.map(x=>x[1].total));
  $("#areaRanking").innerHTML=ranked.map(([a,d])=>`<div class="rank-row"><label>${a}</label><div class="bar-track"><i class="bar-real" style="width:${d.total/max*100}%;background:linear-gradient(90deg,${AREAS[a].color},#93c6c4)"></i></div><strong>${d.total}</strong></div>`).join("");
  renderDonut("#areaStatusDonut",done,pending,late,total);
}
$$(".period-btn").forEach(btn=>btn.addEventListener("click",()=>{
  $$(".period-btn").forEach(b=>{
    const active=b===btn;
    b.classList.toggle("active",active);
    b.setAttribute("aria-pressed",String(active));
  });
  areaPeriod=btn.dataset.period;
  renderAreas();
}));

function renderAreaComparison(){
  const week=AREA_STATS.week,month=AREA_STATS.month;
  const rows=Object.keys(AREAS).map(area=>({
    area,
    current:week[area].total,
    average:month[area].total/4
  })).sort((a,b)=>b.current-a.current);
  const max=Math.max(...rows.flatMap(r=>[r.current,r.average]),1);

  $("#areaComparison").innerHTML=rows.map((r,i)=>`
    <div class="compare-row">
      <label>${r.area}</label>
      <div class="compare-lines">
        <div class="compare-line">
          <span>Semana atual</span>
          <div class="compare-track"><i class="compare-current" style="width:${r.current/max*100}%;animation-delay:${i*.035}s"></i></div>
          <strong>${r.current}</strong>
        </div>
        <div class="compare-line">
          <span>Média/semana</span>
          <div class="compare-track"><i class="compare-average" style="width:${r.average/max*100}%;animation-delay:${.12+i*.035}s"></i></div>
          <strong>${r.average.toFixed(1).replace(".",",")}</strong>
        </div>
      </div>
    </div>`).join("");
}

/* ==========================================================
   INDICATORS
   ========================================================== */
function renderIndicators(){
  const month=AREA_STATS.month,done=sum(Object.values(month).map(x=>x.done)),late=sum(Object.values(month).map(x=>x.late)),onTime=Math.round(done/(done+late)*100);
  $("#indicatorGrid").innerHTML=[
    ["Tarefas recebidas","150","volume do mês"],
    ["Tarefas concluídas",done,Math.round(done/150*100)+"% do total"],
    ["Entregas no prazo",onTime+"%","+3 p.p."],
    ["Tempo médio","4,8 dias","da entrada à conclusão"],
    ["Retrabalho","6%","itens reabertos"]
  ].map(([l,v,s])=>`<article class="indicator"><span>${l}</span><strong>${v}</strong><small>${s}</small></article>`).join("");

  const planned=[36,39,38,41],completed=[32,36,34,38],weeks=["Sem 1","Sem 2","Sem 3","Sem 4"],max=45;
  $("#weekBars").innerHTML=`<div class="week-bars" role="img" aria-label="Comparação entre tarefas planejadas e concluídas por semana">${weeks.map((w,i)=>`<div class="week-col"><i style="height:${planned[i]/max*100}%;animation-delay:${i*.06}s"></i><i class="done" style="height:${completed[i]/max*100}%;animation-delay:${.14+i*.06}s"></i><label>${w}</label></div>`).join("")}</div><div style="display:flex;gap:12px;margin-top:9px;color:var(--muted);font-size:7px"><span>■ Planejadas</span><span style="color:#4c8d73">■ Concluídas</span></div>`;

  const squadEntries=Object.entries(SQUADS),maxSquad=Math.max(...Object.values(SQUADS));
  $("#squadVolume").innerHTML=squadEntries.map(([s,v])=>`<div class="squad-row"><label>${s}</label><div class="bar-track"><i class="bar-real" style="width:${v/maxSquad*100}%"></i></div><strong>${v}</strong></div>`).join("");

  renderOnTimeLine();

  const pending=Object.entries(month).map(([a,d])=>[a,d.pending+d.late]).sort((a,b)=>b[1]-a[1]).slice(0,6);
  const maxPending=Math.max(...pending.map(x=>x[1]));
  $("#pendingAreas").innerHTML=pending.map(([a,v])=>`<div class="rank-row"><label>${a}</label><div class="bar-track"><i class="bar-real" style="width:${v/maxPending*100}%;background:linear-gradient(90deg,var(--amber),var(--rose))"></i></div><strong>${v}</strong></div>`).join("");
}
function renderOnTimeLine(){
  const labels=["Mar","Abr","Mai","Jun","Jul","Ago"],values=[86,87,89,90,91,93],target=[90,90,91,91,92,92];
  const w=620,h=210,p={l:28,r:16,t:12,b:27},xs=labels.map((_,i)=>p.l+i*((w-p.l-p.r)/(labels.length-1))),min=75,max=100;
  const y=v=>h-p.b-((v-min)/(max-min))*(h-p.t-p.b),pts=a=>a.map((v,i)=>`${xs[i]},${y(v)}`).join(" ");
  $("#onTimeChart").innerHTML=`<svg class="line-chart" viewBox="0 0 ${w} ${h}" role="img" aria-label="Evolução das entregas no prazo">
    ${[80,85,90,95,100].map(v=>`<line class="gridline" x1="${p.l}" y1="${y(v)}" x2="${w-p.r}" y2="${y(v)}"/><text class="chart-label" x="2" y="${y(v)+3}">${v}%</text>`).join("")}
    ${labels.map((l,i)=>`<text class="chart-label" text-anchor="middle" x="${xs[i]}" y="${h-7}">${l}</text>`).join("")}
    <polyline class="chart-line secondary" points="${pts(target)}"/><polyline class="chart-line" points="${pts(values)}"/>
    ${values.map((v,i)=>`<circle class="chart-point" style="animation-delay:${i*.07}s" cx="${xs[i]}" cy="${y(v)}" r="4"/>`).join("")}
  </svg><div style="display:flex;gap:12px;color:var(--muted);font-size:7px"><span>— Realizado</span><span style="color:var(--teal)">— Meta</span></div>`;
}

/* ==========================================================
   RISKS
   ========================================================== */
function renderRisks(){
  const filter=$("#riskFilter").value,filtered=filter==="all"?RISKS:RISKS.filter(r=>r.priority===filter);
  const high=RISKS.filter(r=>r.priority==="high").length,medium=RISKS.filter(r=>r.priority==="medium").length,low=RISKS.filter(r=>r.priority==="low").length,avgProgress=Math.round(avg(RISKS.map(r=>r.progress)));
  $("#riskSummary").innerHTML=[
    ["Alta prioridade",high,"olhar primeiro"],
    ["Média prioridade",medium,"acompanhar"],
    ["Baixa prioridade",low,"monitorar"],
    ["Ações em andamento",avgProgress+"%","progresso médio"]
  ].map(([l,v,s])=>`<article class="risk-summary-card"><span>${l}</span><strong>${v}</strong><span>${s}</span></article>`).join("");

  renderRiskAreaChart(filtered);

  $("#riskList").innerHTML=filtered.map(r=>`<article class="risk-card">
    <div class="risk-card-top"><div><h3>${r.title}</h3><p>${r.area} · relacionado à tarefa ${r.task}</p></div><span class="risk-badge ${r.priority}">${priorityLabel(r.priority)} prioridade</span></div>
    <div class="risk-columns">
      <div class="risk-block"><span>O que pode acontecer</span><strong>${r.what}</strong></div>
      <div class="risk-block"><span>Por que isso importa</span><strong>${r.impact}</strong></div>
    </div>
    <div class="risk-block" style="margin-top:9px"><span>Ação em andamento</span><strong>${r.action}</strong></div>
    <div class="risk-foot">
      <div class="risk-meta"><span>Responsável</span><strong>${r.owner}</strong></div>
      <div class="risk-meta"><span>Prazo</span><strong>${r.due}</strong></div>
      <div class="risk-meta"><span>Status</span><strong>${r.status}</strong></div>
      <div class="risk-meta"><span>Tarefa</span><strong>${r.task}</strong></div>
    </div>
    <div class="action-progress"><div class="action-progress-head"><strong>Progresso da ação</strong><span>${r.progress}%</span></div><div class="action-track"><i style="width:${r.progress}%"></i></div></div>
  </article>`).join("");
}
function renderRiskAreaChart(list){
  const counts={};
  list.forEach(r=>counts[r.area]=(counts[r.area]||0)+1);
  const rows=Object.entries(counts).sort((a,b)=>b[1]-a[1]);
  const max=Math.max(...rows.map(([,v])=>v),1);

  $("#riskAreaChart").innerHTML=rows.length
    ? rows.map(([area,value],i)=>`
      <div class="risk-chart-row">
        <label>${area}</label>
        <div class="risk-chart-track"><i style="width:${value/max*100}%;animation-delay:${i*.07}s"></i></div>
        <strong>${value}</strong>
      </div>`).join("")
    : `<div style="padding:16px;color:var(--muted);font-size:12px">Nenhum risco neste filtro.</div>`;
}

$("#riskFilter").addEventListener("change",renderRisks);

/* ==========================================================
   TOP ACTIONS / INIT
   ========================================================== */
$("#notifyBtn").addEventListener("click",()=>toast("3 alertas fictícios: 1 atraso, 1 validação pendente e 1 risco de alta prioridade."));
initKanbanFilter();
const initial=location.hash.replace("#/","")||"overview";
navigate(initial,false);
</script>
</body>
</html>
