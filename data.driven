
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#e8edf4">
<meta name="description" content="Data Driven Hub — case demonstrativo de gestão de demandas, entregas, áreas atendidas, indicadores e riscos.">
<title>Data Driven Hub — Gestão de Demandas e Entregas</title>

<style>
/* ==========================================================
   DATA DRIVEN HUB — V4
   Case demonstrativo • HTML + CSS + JavaScript em arquivo único
   ========================================================== */

:root{
  --bg:#e9eef4;
  --bg-deep:#e2e8f0;
  --surface:#f7f9fc;
  --surface-strong:#ffffff;
  --surface-soft:#f0f4f8;
  --ink:#0f1722;
  --ink-2:#253448;
  --muted:#536276;
  --muted-2:#738296;
  --line:#d2dce7;
  --line-strong:#bcc9d8;
  --navy:#2c4059;
  --navy-2:#24364b;
  --blue:#6386d7;
  --blue-deep:#3e63b3;
  --teal:#61a8ad;
  --green:#5aa280;
  --amber:#d5a755;
  --rose:#cc7283;
  --violet:#8776c9;
  --shadow-sm:0 8px 22px rgba(31,48,68,.07);
  --shadow-md:0 18px 48px rgba(31,48,68,.13);
  --shadow-lg:0 30px 90px rgba(31,48,68,.20);
  --radius:18px;
  --radius-sm:13px;
  --max:1480px;
  --ease:cubic-bezier(.2,.8,.2,1);
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  min-height:100vh;
  color:var(--ink);
  background:
    radial-gradient(circle at 85% 3%,rgba(99,134,215,.08),transparent 25%),
    radial-gradient(circle at 15% 92%,rgba(97,168,173,.07),transparent 24%),
    linear-gradient(180deg,var(--bg),#edf1f6 50%,var(--bg));
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
body.lock{overflow:hidden}
button,input,select,textarea{font:inherit}
button{color:inherit}
a{color:inherit;text-decoration:none}
svg{display:block;max-width:100%}
:focus-visible{outline:3px solid rgba(99,134,215,.30);outline-offset:3px}
::selection{background:rgba(99,134,215,.18)}
.hidden{display:none!important}

/* ---------- APP HEADER ---------- */
.app-header{
  position:sticky;top:0;z-index:70;
  background:rgba(233,238,244,.92);
  backdrop-filter:blur(18px) saturate(130%);
  border-bottom:1px solid var(--line);
}
.header-main{
  width:min(calc(100% - 40px),var(--max));
  min-height:70px;margin:auto;
  display:flex;align-items:center;justify-content:space-between;gap:20px
}
.brand{display:flex;align-items:center;gap:11px;min-width:max-content}
.brand-mark{
  position:relative;overflow:hidden;
  width:42px;height:42px;border-radius:13px;
  background:linear-gradient(145deg,#7899dd,#67afb0);
  box-shadow:0 9px 22px rgba(62,99,179,.18)
}
.brand-mark i{
  position:absolute;bottom:9px;width:5px;border-radius:4px;background:#fff
}
.brand-mark .b1{left:9px;height:9px}.brand-mark .b2{left:18px;height:17px}.brand-mark .b3{left:27px;height:25px}
.brand-mark::after{
  content:"";position:absolute;left:7px;top:12px;width:31px;height:2px;
  transform:rotate(-28deg);transform-origin:left center;background:rgba(255,255,255,.86);
  animation:logoPulse 3.6s ease-in-out infinite
}
@keyframes logoPulse{50%{opacity:.45;transform:rotate(-28deg) scaleX(1.16)}}
.brand strong{display:block;font-size:15px;letter-spacing:-.015em}
.brand span{display:block;margin-top:2px;color:var(--muted);font-size:8px;letter-spacing:.09em;text-transform:uppercase}
.header-meta{display:flex;align-items:center;gap:8px}
.demo-pill{
  display:inline-flex;align-items:center;gap:7px;
  min-height:34px;padding:0 10px;border:1px solid var(--line);border-radius:999px;
  background:var(--surface);color:var(--muted);font-size:7.5px;font-weight:800
}
.demo-pill i{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 5px rgba(90,162,128,.08)}
.icon-btn{
  width:37px;height:37px;border:1px solid var(--line);border-radius:11px;
  background:var(--surface);cursor:pointer
}
.avatar{
  width:36px;height:36px;border-radius:50%;display:grid;place-items:center;
  background:#dbe5f2;border:1px solid #c5d1df;color:#334c69;font-size:8px;font-weight:900
}

/* ---------- HORIZONTAL NAV ---------- */
.tabbar{
  border-top:1px solid rgba(210,220,231,.7);
  background:rgba(241,245,249,.68)
}
.tabs{
  width:min(calc(100% - 40px),var(--max));
  margin:auto;display:flex;align-items:center;gap:4px;overflow-x:auto;
  scrollbar-width:none
}
.tabs::-webkit-scrollbar{display:none}
.tab{
  position:relative;min-height:48px;padding:0 18px;border:0;background:transparent;
  color:#526276;cursor:pointer;font-size:9px;font-weight:850;white-space:nowrap
}
.tab::after{
  content:"";position:absolute;left:50%;right:50%;bottom:0;height:3px;border-radius:99px 99px 0 0;
  background:linear-gradient(90deg,var(--blue),var(--teal));transition:.2s var(--ease)
}
.tab:hover{color:var(--ink)}
.tab.active{color:var(--ink);font-weight:950}
.tab.active::after{left:10px;right:10px}

/* ---------- PAGE ---------- */
.page{
  display:none;
  width:min(calc(100% - 40px),var(--max));
  margin:auto;padding:24px 0 52px;
  animation:pageIn .32s var(--ease) both
}
.page.active{display:block}
@keyframes pageIn{from{opacity:.2;transform:translateY(7px)}to{opacity:1;transform:none}}
.page-head{
  display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:16px
}
.page-head h1{margin:0;color:#0a111c;font-size:25px;line-height:1.15;letter-spacing:-.035em}
.page-head p{max-width:760px;margin:6px 0 0;color:var(--muted);font-size:9.5px;line-height:1.6}
.page-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.filter,.btn{
  min-height:38px;border-radius:10px;font-size:8px;font-weight:850
}
.filter{
  padding:0 31px 0 10px;border:1px solid var(--line);background:var(--surface-strong);color:var(--ink)
}
.btn{
  padding:0 12px;border:1px solid var(--line);background:var(--surface-strong);cursor:pointer;
  display:inline-flex;align-items:center;justify-content:center;gap:7px;transition:.2s var(--ease)
}
.btn:hover{transform:translateY(-2px);box-shadow:var(--shadow-sm)}
.btn.primary{border-color:transparent;color:#fff;background:linear-gradient(135deg,var(--blue-deep),#43868c)}
.btn.ghost{background:var(--surface-soft)}

/* ---------- HERO ---------- */
.hero{
  position:relative;overflow:hidden;isolation:isolate;
  min-height:174px;margin-bottom:14px;border-radius:20px;
  color:#fff;background:
    radial-gradient(circle at 14% 22%,rgba(255,255,255,.13),transparent 25%),
    radial-gradient(circle at 82% 25%,rgba(255,255,255,.10),transparent 24%),
    linear-gradient(135deg,#304a67,#456382 55%,#49757c);
  box-shadow:var(--shadow-md)
}
.hero::before{
  content:"";position:absolute;inset:0;z-index:-1;
  background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);
  background-size:27px 27px;mask-image:linear-gradient(90deg,#000,transparent 88%)
}
.hero-inner{min-height:174px;padding:22px 25px;display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:18px}
.hero-kicker{
  display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border-radius:999px;
  background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.09);
  font-size:7px;font-weight:900;text-transform:uppercase;letter-spacing:.08em
}
.hero h2{max-width:690px;margin:10px 0 6px;font-size:23px;line-height:1.13;letter-spacing:-.03em}
.hero p{max-width:670px;margin:0;color:#f1f5f9;font-size:9px;line-height:1.62}
.hero-chips{display:flex;gap:7px;flex-wrap:wrap;margin-top:11px}
.hero-chip{padding:6px 8px;border-radius:999px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.08);font-size:7px;font-weight:850}
.hero-visual{position:relative;min-height:130px;display:grid;place-items:center}
.orbit{position:absolute;border-radius:50%;border:1px dashed rgba(255,255,255,.18);animation:orbit 15s linear infinite}
.orbit.o1{width:135px;height:135px}.orbit.o2{width:88px;height:88px;animation-duration:9.5s;animation-direction:reverse}
@keyframes orbit{to{transform:rotate(360deg)}}
.orbit i{position:absolute;width:8px;height:8px;border-radius:50%;background:#e1ecff;box-shadow:0 0 16px rgba(255,255,255,.55)}
.orbit.o1 i:first-child{top:-4px;left:50%}.orbit.o1 i:last-child{bottom:8px;right:8px;background:#d5f3ec}.orbit.o2 i{right:-4px;top:32px;background:#e8dcff}
.hero-core{
  width:68px;height:68px;border-radius:22px;display:grid;place-items:center;
  background:linear-gradient(145deg,#7d9fe1,#75b5b1);font-size:22px;font-weight:900;
  box-shadow:0 17px 42px rgba(20,40,67,.25),0 0 0 10px rgba(255,255,255,.04);
  animation:coreFloat 4.5s ease-in-out infinite
}
@keyframes coreFloat{50%{transform:translateY(-6px) rotate(3deg)}}
.stream{
  position:absolute;left:0;right:0;height:2px;overflow:hidden;opacity:.42;
  background:linear-gradient(90deg,transparent,#dbeafe,#d1fae5,transparent)
}
.stream::after{
  content:"";position:absolute;left:-28%;top:-2px;width:32%;height:6px;
  background:linear-gradient(90deg,transparent,#fff,#dbeafe,transparent);animation:streamMove 3.3s ease-in-out infinite
}
.stream.s1{top:30%;transform:rotate(13deg)}.stream.s2{top:68%;transform:rotate(-17deg)}.stream.s2::after{animation-delay:-1.65s}
@keyframes streamMove{0%{transform:translateX(-100%);opacity:0}20%,80%{opacity:.8}100%{transform:translateX(470%);opacity:0}}

/* ---------- PANELS / KPI ---------- */
.panel,.kpi,.area-card,.risk-card{
  border:1px solid var(--line);background:var(--surface);box-shadow:var(--shadow-sm)
}
.panel{border-radius:17px;padding:15px}
.panel-head{display:flex;align-items:center;justify-content:space-between;gap:13px;margin-bottom:11px}
.panel-title h3{margin:0;font-size:11px;letter-spacing:-.01em}
.panel-title p{margin:4px 0 0;color:var(--muted);font-size:7.5px}
.panel-action{border:0;background:transparent;color:var(--blue-deep);cursor:pointer;font-size:7.5px;font-weight:900}

.kpi-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:13px}
.kpi{position:relative;overflow:hidden;min-height:110px;padding:13px;border-radius:15px}
.kpi::after{content:"";position:absolute;right:-24px;top:-28px;width:82px;height:82px;border-radius:50%;background:var(--glow)}
.kpi-top{display:flex;align-items:center;justify-content:space-between;gap:7px}
.kpi-label{color:#38495e;font-size:7.5px;font-weight:850}
.kpi-icon{width:28px;height:28px;border-radius:9px;display:grid;place-items:center;background:var(--icon-bg);color:var(--icon-fg);font-size:11px}
.kpi strong{display:block;margin-top:10px;font-size:23px;line-height:1;letter-spacing:-.04em}
.kpi small{display:block;margin-top:7px;color:var(--muted);font-size:6.5px}.positive{color:var(--green);font-weight:900}.negative{color:var(--rose);font-weight:900}

.grid-2{display:grid;grid-template-columns:1.25fr .75fr;gap:12px;margin-bottom:12px}
.grid-2.equal{grid-template-columns:1fr 1fr}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}

/* ---------- CHARTS ---------- */
.bar-list{display:grid;gap:9px}
.bar-row{display:grid;grid-template-columns:55px 1fr 36px;gap:8px;align-items:center}
.bar-row label{color:#45566c;font-size:7px;font-weight:850}
.bar-track{position:relative;height:13px;border-radius:99px;background:#e4ebf2;overflow:hidden}
.bar-plan,.bar-real{position:absolute;left:0;border-radius:99px;animation:growBar 1s var(--ease) backwards}
.bar-plan{top:0;bottom:0;background:rgba(99,134,215,.18)}
.bar-real{top:3px;height:7px;background:linear-gradient(90deg,var(--blue-deep),var(--teal))}
@keyframes growBar{from{transform:scaleX(0);transform-origin:left}}
.bar-row strong{font-size:7.5px;text-align:right}

.donut-layout{display:grid;grid-template-columns:135px 1fr;gap:13px;align-items:center}
.donut{
  position:relative;width:130px;height:130px;border-radius:50%;display:grid;place-items:center;
  animation:donutIn .8s var(--ease) both
}
@keyframes donutIn{from{transform:rotate(-50deg) scale(.83);opacity:0}}
.donut::after{content:"";width:82px;height:82px;border-radius:50%;background:var(--surface);box-shadow:inset 0 0 0 1px var(--line)}
.donut-center{position:absolute;z-index:2;text-align:center}.donut-center strong{display:block;font-size:20px}.donut-center span{font-size:6.5px;color:var(--muted)}
.donut-legend{display:grid;gap:7px}.d-row{display:flex;justify-content:space-between;gap:8px;font-size:7.5px}.d-row span{display:flex;align-items:center;gap:6px;color:var(--muted)}.dot{width:7px;height:7px;border-radius:50%}

.line-chart{width:100%;height:220px;overflow:visible}
.gridline{stroke:var(--line);stroke-width:1}.chart-label{fill:var(--muted);font-size:7px}
.chart-line{fill:none;stroke:var(--blue-deep);stroke-width:3;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1000;stroke-dashoffset:1000;animation:drawLine 2s var(--ease) forwards}
.chart-line.secondary{stroke:var(--teal);animation-delay:.12s}
@keyframes drawLine{to{stroke-dashoffset:0}}
.chart-point{fill:var(--surface);stroke:var(--blue-deep);stroke-width:2;animation:pointPop .4s var(--ease) backwards}
@keyframes pointPop{from{transform:scale(0)}}

/* ---------- TABLE ---------- */
.data-list{display:grid}
.data-row{
  display:grid;grid-template-columns:minmax(190px,1.35fr) 100px 90px 82px 72px;gap:9px;
  align-items:center;padding:10px 0;border-bottom:1px solid var(--line)
}
.data-row:last-child{border-bottom:0}
.row-title{min-width:0}.row-title b{display:block;font-size:8.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.row-title span{display:block;margin-top:3px;color:var(--muted);font-size:6.5px}
.status{
  display:inline-flex;align-items:center;justify-content:center;gap:5px;min-height:21px;padding:0 7px;border-radius:999px;
  font-size:6.5px;font-weight:900
}
.status::before{content:"";width:6px;height:6px;border-radius:50%}
.st-done{background:rgba(90,162,128,.10);color:#39795f}.st-done::before{background:var(--green)}
.st-pending{background:rgba(213,167,85,.12);color:#8c6828}.st-pending::before{background:var(--amber)}
.st-late{background:rgba(204,114,131,.11);color:#994757}.st-late::before{background:var(--rose)}
.st-progress{background:rgba(99,134,215,.11);color:#3f5fa1}.st-progress::before{background:var(--blue)}
.progress{display:flex;align-items:center;gap:6px}.progress .track{height:6px;flex:1;border-radius:99px;background:#e3eaf1;overflow:hidden}.progress .fill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--blue),var(--teal))}.progress span{font-size:6.5px;font-weight:900}
.mini-avatar{width:23px;height:23px;border-radius:50%;display:grid;place-items:center;background:#dce6f4;border:1px solid #c7d3e2;color:#36506f;font-size:6px;font-weight:900}

/* ---------- KANBAN ---------- */
.kanban-board{
  display:grid;grid-template-columns:repeat(5,minmax(250px,1fr));gap:11px;overflow-x:auto;padding-bottom:9px;
  scrollbar-width:thin
}
.kanban-col{
  position:relative;min-width:250px;min-height:590px;padding:12px;border:1px solid var(--line);border-radius:16px;overflow:hidden;
  background:linear-gradient(180deg,var(--soft) 0 88px,#edf2f6 190px)
}
.kanban-col::before{content:"";position:absolute;left:0;right:0;top:0;height:5px;background:var(--stage)}
.kanban-col[data-stage="Backlog"]{--stage:#9582d3;--soft:#efebfa}
.kanban-col[data-stage="A fazer"]{--stage:#68a9c0;--soft:#e9f4f7}
.kanban-col[data-stage="Em andamento"]{--stage:#6487d8;--soft:#ebf1fb}
.kanban-col[data-stage="Em validação"]{--stage:#d0a24f;--soft:#f8f2e4}
.kanban-col[data-stage="Concluído"]{--stage:#5ca17f;--soft:#eaf5ef}
.col-head{display:flex;align-items:center;justify-content:space-between;padding:2px 2px 10px}
.col-head strong{font-size:9.5px}.count{min-width:23px;height:23px;border-radius:999px;display:grid;place-items:center;background:var(--surface);border:1px solid var(--line);font-size:6.5px;font-weight:900}
.kanban-cards{display:grid;gap:9px}
.kanban-card{
  position:relative;min-height:165px;padding:14px;border:1px solid var(--line);border-radius:14px;
  background:var(--surface-strong);box-shadow:0 5px 14px rgba(31,48,68,.05);
  cursor:pointer;transition:.2s var(--ease)
}
.kanban-card:hover{transform:translateY(-3px);border-color:#b7c5d6;box-shadow:var(--shadow-sm)}
.kanban-card.dragging{opacity:.45;transform:rotate(1.5deg) scale(.985)}
.k-top{display:flex;justify-content:space-between;align-items:center;gap:7px}
.task-key{color:#5f7188;font-size:6.5px;font-weight:950;letter-spacing:.08em}
.priority-dot{width:7px;height:7px;border-radius:50%;background:var(--amber)}.priority-dot.high{background:var(--rose)}.priority-dot.low{background:var(--green)}
.kanban-card h4{margin:9px 0 0;font-size:9.5px;line-height:1.42}
.kanban-card p{margin:5px 0 0;color:var(--muted);font-size:7px;line-height:1.45}
.k-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}.tag{padding:4px 6px;border-radius:7px;background:var(--surface-soft);color:var(--muted);font-size:6px;font-weight:850}
.k-foot{display:flex;align-items:center;justify-content:space-between;margin-top:12px}.due{font-size:6.5px;color:var(--muted)}
.mobile-stage{
  display:none;margin-top:9px;width:100%;min-height:31px;padding:0 8px;border:1px solid var(--line);border-radius:9px;background:var(--surface-soft);font-size:7px;font-weight:850
}

/* ---------- AREAS ---------- */
.period-switch{
  display:inline-flex;gap:4px;padding:3px;border-radius:10px;background:#dde5ee;border:1px solid #d0dae5
}
.period-btn{
  min-height:31px;padding:0 11px;border:0;border-radius:8px;background:transparent;color:var(--muted);cursor:pointer;font-size:7px;font-weight:900
}
.period-btn.active{background:var(--surface-strong);color:var(--ink);box-shadow:0 4px 12px rgba(31,48,68,.08)}
.area-summary{
  display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px
}
.summary-card{
  padding:13px;border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:var(--shadow-sm)
}
.summary-card span{font-size:7px;color:var(--muted);font-weight:850}.summary-card strong{display:block;margin-top:7px;font-size:21px}
.area-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:12px}
.area-card{
  position:relative;overflow:hidden;min-height:160px;padding:14px;border-radius:15px;cursor:pointer;transition:.2s var(--ease)
}
.area-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md);border-color:#b7c5d6}
.area-card::after{content:"";position:absolute;right:-26px;top:-26px;width:88px;height:88px;border-radius:50%;background:var(--area-soft)}
.area-icon{width:31px;height:31px;border-radius:10px;display:grid;place-items:center;background:var(--area-soft);color:var(--area);font-size:8px;font-weight:950}
.area-card h3{margin:9px 0 4px;font-size:9.5px}.area-card p{margin:0;color:var(--muted);font-size:6.7px;line-height:1.45}
.area-total{display:flex;align-items:end;justify-content:space-between;gap:8px;margin-top:10px}.area-total strong{font-size:20px}.area-total span{font-size:6.5px;color:var(--muted)}
.area-status{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin-top:9px}
.area-status div{padding:6px;border-radius:8px;background:var(--surface-soft);text-align:center}.area-status strong{display:block;font-size:8px}.area-status span{font-size:5.8px;color:var(--muted)}
.stackbar{height:6px;margin-top:9px;border-radius:99px;overflow:hidden;display:flex;background:#e5ebf2}.stackbar i{display:block;height:100%}.stackbar .done{background:var(--green)}.stackbar .pending{background:var(--amber)}.stackbar .late{background:var(--rose)}
.area-ranking .rank-row{display:grid;grid-template-columns:130px 1fr 36px;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line)}.area-ranking .rank-row:last-child{border-bottom:0}.rank-row label{font-size:7px;font-weight:850}.rank-row .bar-track{height:11px}.rank-row strong{font-size:7.5px;text-align:right}

/* ---------- INDICATORS ---------- */
.indicator-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:12px}
.indicator{
  padding:14px;border:1px solid var(--line);border-radius:15px;background:var(--surface);box-shadow:var(--shadow-sm)
}
.indicator span{font-size:7px;color:var(--muted);font-weight:850}.indicator strong{display:block;margin-top:8px;font-size:22px}.indicator small{display:block;margin-top:5px;color:var(--muted);font-size:6.5px}
.week-bars{
  height:205px;display:flex;align-items:end;gap:13px;padding:9px 9px 17px;border-bottom:1px solid var(--line);position:relative
}
.week-bars::before{content:"";position:absolute;inset:9px 0 17px;background:repeating-linear-gradient(to top,var(--line) 0 1px,transparent 1px 45px)}
.week-col{position:relative;z-index:2;flex:1;height:100%;display:flex;align-items:end;justify-content:center;gap:4px}
.week-col i{width:15px;border-radius:7px 7px 2px 2px;animation:rise 1s var(--ease) backwards;background:linear-gradient(to top,var(--blue-deep),#8ea7e1)}
.week-col i.done{background:linear-gradient(to top,#43826a,#79b89d)}
@keyframes rise{from{height:0!important}}
.week-col label{position:absolute;bottom:-15px;font-size:6.5px;color:var(--muted)}
.squad-row{display:grid;grid-template-columns:145px 1fr 54px;gap:8px;align-items:center;padding:9px 0;border-bottom:1px solid var(--line)}.squad-row:last-child{border-bottom:0}.squad-row label{font-size:7.5px;font-weight:850}.squad-row strong{text-align:right;font-size:7.5px}

/* ---------- RISKS ---------- */
.risk-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px}
.risk-summary-card{padding:13px;border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:var(--shadow-sm)}
.risk-summary-card span{font-size:7px;color:var(--muted);font-weight:850}.risk-summary-card strong{display:block;margin-top:7px;font-size:21px}
.risk-intro{
  margin-bottom:12px;padding:12px 14px;border:1px solid #d7e1ec;border-radius:13px;background:#edf3f8;
  color:#33465b;font-size:8px;line-height:1.55
}
.risk-list{display:grid;gap:9px}
.risk-card{padding:13px;border-radius:15px}
.risk-card-top{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:start}
.risk-card h3{margin:0;font-size:10px}.risk-card p{margin:4px 0 0;color:var(--muted);font-size:7px;line-height:1.5}
.risk-badge{min-width:78px;padding:7px;border-radius:9px;text-align:center;font-size:6.5px;font-weight:950}
.risk-badge.high{background:#f8e8eb;color:#984757}.risk-badge.medium{background:#f7f0df;color:#8b6829}.risk-badge.low{background:#e8f3ed;color:#39765f}
.risk-columns{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:10px}
.risk-block{padding:10px;border-radius:11px;background:var(--surface-soft);border:1px solid #e1e7ee}
.risk-block span{display:block;color:var(--muted);font-size:6px;text-transform:uppercase;letter-spacing:.06em;font-weight:900}.risk-block strong{display:block;margin-top:5px;font-size:7.5px;line-height:1.5}
.risk-foot{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:9px}
.risk-meta{padding:8px;border-radius:9px;background:#edf2f6}.risk-meta span{display:block;color:var(--muted);font-size:5.8px;text-transform:uppercase;font-weight:900}.risk-meta strong{display:block;margin-top:4px;font-size:7px}
.action-progress{margin-top:9px;padding-top:9px;border-top:1px solid var(--line)}.action-progress-head{display:flex;justify-content:space-between;gap:8px;font-size:6.5px}.action-progress-head span{color:var(--muted)}.action-track{height:6px;margin-top:6px;border-radius:99px;background:#e3eaf1;overflow:hidden}.action-track i{display:block;height:100%;background:linear-gradient(90deg,var(--amber),var(--green))}

/* ---------- JIRA-LIKE MODAL ---------- */
.modal-scrim{
  position:fixed;inset:0;z-index:150;padding:18px;display:grid;place-items:center;
  background:rgba(24,36,52,.46);backdrop-filter:blur(5px);
  opacity:0;pointer-events:none;transition:.22s
}
.modal-scrim.open{opacity:1;pointer-events:auto}
.task-modal{
  width:min(1080px,97vw);max-height:min(820px,94vh);overflow:auto;
  border:1px solid #cdd8e4;border-radius:19px;background:#f7f9fb;
  box-shadow:var(--shadow-lg);transform:translateY(16px) scale(.986);transition:.22s var(--ease)
}
.modal-scrim.open .task-modal{transform:none}
.task-head{
  position:sticky;top:0;z-index:4;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;
  padding:17px 20px 13px;border-bottom:1px solid var(--line);
  background:rgba(247,249,251,.95);backdrop-filter:blur(14px)
}
.task-head-left{min-width:0}.task-head .key{display:flex;align-items:center;gap:6px;color:#5d6f86;font-size:7px;font-weight:900}.task-head h2{margin:7px 0 0;font-size:20px;letter-spacing:-.025em}
.task-head-actions{display:flex;gap:7px}
.modal-close,.modal-action{
  min-height:36px;border:1px solid var(--line);border-radius:9px;background:#fff;cursor:pointer;font-size:7.5px;font-weight:850
}
.modal-close{width:36px;font-size:17px}.modal-action{padding:0 10px}
.task-layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:0}
.task-main{padding:18px 20px 24px;border-right:1px solid var(--line)}
.task-side{padding:18px;background:#f0f4f8}
.jira-section{margin-bottom:18px}.jira-section h3{margin:0 0 8px;font-size:9px}.jira-section p{margin:0;color:#34455a;font-size:8px;line-height:1.65}
.description-box{padding:12px;border:1px solid var(--line);border-radius:11px;background:#fff}
.checklist{display:grid;gap:7px}.check-item{display:flex;align-items:center;gap:8px;font-size:7.5px;color:#34455a}.check-item input{accent-color:var(--blue-deep)}
.comment-list{display:grid;gap:10px}.comment{display:grid;grid-template-columns:30px 1fr;gap:8px}.comment-avatar{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#dce6f4;color:#36506f;font-size:6px;font-weight:900}.comment-body{padding:9px;border:1px solid var(--line);border-radius:10px;background:#fff}.comment-body strong{font-size:7.5px}.comment-body time{margin-left:6px;color:var(--muted);font-size:6px}.comment-body p{margin:5px 0 0;font-size:7.5px}
.comment-form{display:grid;grid-template-columns:1fr auto;gap:7px;margin-top:9px}.comment-input{min-height:37px;padding:0 10px;border:1px solid var(--line);border-radius:9px;background:#fff;color:var(--ink);font-size:7.5px}.comment-submit{padding:0 11px;border:0;border-radius:9px;background:var(--blue-deep);color:#fff;font-size:7px;font-weight:900;cursor:pointer}
.side-section{margin-bottom:16px}.side-section h3{margin:0 0 8px;font-size:8px}.detail-list{display:grid;gap:9px}.detail-row{display:grid;grid-template-columns:88px 1fr;gap:8px;align-items:center}.detail-row span,.detail-row label{color:var(--muted);font-size:6.5px;font-weight:850}.detail-row strong{font-size:7.5px;line-height:1.4}
.user-chip{display:flex;align-items:center;gap:7px}.user-chip .mini-avatar{width:26px;height:26px}.priority-chip{display:inline-flex;align-items:center;gap:5px;padding:5px 7px;border-radius:7px;background:#f8e8eb;color:#984757;font-size:6.5px;font-weight:900}
.priority-chip.medium{background:#f7f0df;color:#876425}.priority-chip.low{background:#e9f3ee;color:#39765f}
.label-row{display:flex;gap:5px;flex-wrap:wrap}.label{padding:5px 6px;border-radius:7px;background:#e3e9f0;color:#54667d;font-size:6px;font-weight:850}
.activity{display:grid;gap:7px}.activity-item{padding-left:10px;border-left:2px solid #ccd7e4;font-size:6.5px;color:var(--muted);line-height:1.5}.activity-item strong{color:#34455a}

/* ---------- TOAST ---------- */
.toasts{position:fixed;right:17px;top:86px;z-index:190;display:grid;gap:7px;pointer-events:none}
.toast{min-width:245px;max-width:340px;padding:10px 12px;border-radius:10px;background:#2c4059;color:#fff;box-shadow:var(--shadow-md);font-size:7.5px;animation:toastIn .25s var(--ease) both}
@keyframes toastIn{from{opacity:0;transform:translateY(-6px) translateX(10px)}}

/* ---------- RESPONSIVE ---------- */
@media(max-width:1180px){
  .kpi-grid,.indicator-grid{grid-template-columns:repeat(3,1fr)}
  .grid-2,.grid-2.equal{grid-template-columns:1fr}
  .area-grid{grid-template-columns:repeat(3,1fr)}
  .area-summary,.risk-summary{grid-template-columns:repeat(2,1fr)}
  .data-row{grid-template-columns:minmax(180px,1.3fr) 95px 88px 68px}.data-row .owner-cell{display:none}
}
@media(max-width:900px){
  .header-main,.tabs,.page{width:min(calc(100% - 24px),var(--max))}
  .header-meta .demo-pill{display:none}
  .hero-inner{grid-template-columns:1fr .55fr}
  .area-grid{grid-template-columns:repeat(2,1fr)}
  .task-layout{grid-template-columns:1fr}.task-main{border-right:0;border-bottom:1px solid var(--line)}.task-side{background:#eef3f7}
}
@media(max-width:650px){
  .header-main{min-height:62px}.brand span{display:none}.brand-mark{width:38px;height:38px}
  .header-meta .icon-btn{display:none}
  .tabs{width:100%;padding-inline:8px}.tab{min-height:44px;padding:0 13px}
  .page{padding-top:17px}.page-head{display:grid}.page-head h1{font-size:21px}.page-actions{justify-content:flex-start}
  .hero{min-height:260px}.hero-inner{grid-template-columns:1fr;min-height:260px;padding:18px}.hero-copy{max-width:80%}.hero h2{font-size:19px}.hero-visual{position:absolute;right:-28px;top:30px;width:180px;opacity:.40}
  .kpi-grid,.indicator-grid{grid-template-columns:1fr 1fr;gap:8px}.kpi{min-height:105px}
  .grid-3{grid-template-columns:1fr}
  .area-grid{grid-template-columns:1fr}.area-summary,.risk-summary{grid-template-columns:1fr 1fr}
  .data-row{grid-template-columns:1fr auto}.data-row .progress-cell,.data-row .owner-cell,.data-row .extra-cell{display:none}
  .mobile-stage{display:block}
  .risk-columns{grid-template-columns:1fr}.risk-foot{grid-template-columns:1fr 1fr}
  .task-modal{max-height:96vh;border-radius:16px}.modal-scrim{padding:6px}.task-head,.task-main,.task-side{padding-left:14px;padding-right:14px}.task-head h2{font-size:17px}.task-head-actions .modal-action{display:none}.detail-row{grid-template-columns:76px 1fr}
  .comment-form{grid-template-columns:1fr}.comment-submit{min-height:35px}
  .toasts{left:10px;right:10px}.toast{min-width:0;max-width:none}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}
}

/* ==========================================================
   V5 — ACESSIBILIDADE E LEGIBILIDADE
   Escala tipográfica revisada, contraste, teclado e touch.
   ========================================================== */

.skip-link{
  position:fixed;
  top:10px;
  left:12px;
  z-index:999;
  transform:translateY(-150%);
  padding:10px 14px;
  border-radius:10px;
  background:#0f1722;
  color:#fff;
  font-size:14px;
  font-weight:800;
  box-shadow:var(--shadow-md);
  transition:transform .18s var(--ease);
}
.skip-link:focus{transform:translateY(0)}

.sr-only{
  position:absolute!important;
  width:1px!important;
  height:1px!important;
  padding:0!important;
  margin:-1px!important;
  overflow:hidden!important;
  clip:rect(0,0,0,0)!important;
  white-space:nowrap!important;
  border:0!important;
}

/* Base */
body{font-size:14px;line-height:1.5}
.brand strong{font-size:16px}
.brand span{font-size:10px}
.demo-pill{font-size:10px}
.tab{font-size:13px;min-height:50px;padding-inline:20px}
.page-head h1{font-size:28px}
.page-head p{font-size:13px;line-height:1.65}
.filter,.btn{font-size:12px;min-height:42px}
.btn{padding-inline:14px}

/* Hero */
.hero-kicker{font-size:10px}
.hero h2{font-size:27px}
.hero p{font-size:13px;line-height:1.65}
.hero-chip{font-size:10px;padding:7px 10px}

/* Panels */
.panel-title h3{font-size:15px}
.panel-title p{font-size:11px;line-height:1.5}
.panel-action{font-size:11px;min-height:32px}

/* KPIs */
.kpi{min-height:122px;padding:15px}
.kpi-label{font-size:11px}
.kpi strong{font-size:27px}
.kpi small{font-size:10.5px;line-height:1.45}
.kpi-icon{font-size:13px;width:31px;height:31px}

/* Gráficos e barras */
.bar-row{grid-template-columns:70px 1fr 42px}
.bar-row label{font-size:10.5px}
.bar-row strong{font-size:10.5px}
.chart-label{font-size:10px}
.donut-center span{font-size:10px}
.d-row{font-size:10.5px}

/* Listas */
.row-title b{font-size:12px}
.row-title span{font-size:10px;line-height:1.4}
.status{font-size:10px;min-height:26px;padding-inline:9px}
.progress span{font-size:10px}
.mini-avatar{font-size:8px}

/* Kanban */
.kanban-col{min-width:270px}
.col-head strong{font-size:12px}
.count{font-size:10px;min-width:26px;height:26px}
.kanban-card{min-height:180px;padding:15px}
.task-key{font-size:10px}
.kanban-card h4{font-size:13px;line-height:1.45}
.kanban-card p{font-size:10.5px;line-height:1.5}
.tag{font-size:9.5px;padding:5px 7px}
.due{font-size:10px}
.mobile-stage{font-size:12px;min-height:40px}

/* Áreas */
.period-btn{font-size:11px;min-height:38px}
.summary-card span{font-size:10.5px}
.summary-card strong{font-size:24px}
.area-card{min-height:180px}
.area-icon{font-size:10px}
.area-card h3{font-size:13px}
.area-card p{font-size:10.5px;line-height:1.5}
.area-total span{font-size:10px}
.area-status strong{font-size:11px}
.area-status span{font-size:9px}
.rank-row label{font-size:10.5px}
.rank-row strong{font-size:10.5px}

/* Indicadores */
.indicator span{font-size:10.5px}
.indicator strong{font-size:25px}
.indicator small{font-size:10px}
.week-col label{font-size:10px}
.squad-row label{font-size:10.5px}
.squad-row strong{font-size:10.5px}

/* Riscos */
.risk-summary-card span{font-size:10.5px}
.risk-summary-card strong{font-size:24px}
.risk-intro{font-size:12px;line-height:1.65}
.risk-card h3{font-size:14px}
.risk-card p{font-size:11px;line-height:1.55}
.risk-badge{font-size:10px;min-width:96px}
.risk-block span{font-size:9.5px}
.risk-block strong{font-size:11.5px;line-height:1.55}
.risk-meta span{font-size:9px}
.risk-meta strong{font-size:10.5px}
.action-progress-head{font-size:10px}

/* Modal estilo Jira */
.task-head .key{font-size:10px}
.task-head h2{font-size:23px}
.modal-action{font-size:11px;min-height:40px}
.modal-close{width:40px;height:40px}
.jira-section h3{font-size:13px}
.jira-section p{font-size:12.5px;line-height:1.65}
.check-item{font-size:12px}
.comment-avatar{font-size:8px}
.comment-body strong{font-size:11.5px}
.comment-body time{font-size:9.5px}
.comment-body p{font-size:12px;line-height:1.55}
.comment-input{font-size:12px;min-height:42px}
.comment-submit{font-size:11px;min-height:42px}
.side-section h3{font-size:12px}
.detail-row span,.detail-row label{font-size:10px}
.detail-row strong{font-size:11.5px}
.priority-chip{font-size:10px}
.label{font-size:9.5px}
.activity-item{font-size:10.5px;line-height:1.55}

.detail-select{
  width:100%;
  min-height:38px;
  padding:0 9px;
  border:1px solid var(--line);
  border-radius:8px;
  background:#fff;
  color:var(--ink);
  font-size:11px;
  font-weight:750;
}

/* Critérios de aceite: conteúdo informativo, não checkbox desabilitado */
.criteria-list{
  margin:0;
  padding:0;
  list-style:none;
  display:grid;
  gap:8px;
}
.criteria-list li{
  position:relative;
  padding-left:23px;
  color:#34455a;
  font-size:12px;
  line-height:1.5;
}
.criteria-list li::before{
  content:"✓";
  position:absolute;
  left:0;
  top:0;
  width:16px;
  height:16px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#e6f2eb;
  color:#39795f;
  font-size:10px;
  font-weight:900;
}

/* Melhor foco em componentes customizados */
.tab:focus-visible,
.kanban-card:focus-visible,
.area-card:focus-visible,
.period-btn:focus-visible{
  outline:3px solid rgba(62,99,179,.32);
  outline-offset:3px;
}

/* Alvos de toque */
@media(max-width:650px){
  .tab{min-height:48px;font-size:12px}
  .page-head h1{font-size:24px}
  .page-head p{font-size:13px}
  .hero h2{font-size:22px}
  .hero p{font-size:13px}
  .filter,.btn,.period-btn,.mobile-stage,.comment-input,.comment-submit,
  input,select,textarea{
    min-height:44px;
    font-size:16px!important;
  }
  .kpi-label{font-size:11px}
  .kpi small{font-size:10.5px}
  .risk-card h3{font-size:14px}
  .risk-card p,.risk-block strong{font-size:12px}
  .task-head h2{font-size:20px}
  .detail-select{font-size:16px;min-height:44px}
}


/* ==========================================================
   V6 — LEITURA, UX E MOVIMENTO
   Fontes maiores + animações funcionais por página.
   ========================================================== */

@keyframes cardRevealV6{
  from{opacity:0;transform:translateY(12px) scale(.988)}
  to{opacity:1;transform:none}
}
@keyframes softHoverPulse{
  0%,100%{box-shadow:var(--shadow-sm)}
  50%{box-shadow:0 12px 30px rgba(31,48,68,.10)}
}
@keyframes flowTravel{
  0%{left:2%;opacity:0}
  7%{opacity:1}
  93%{opacity:1}
  100%{left:96%;opacity:0}
}
@keyframes flowGlow{
  0%,100%{transform:scale(1);box-shadow:0 0 0 0 rgba(99,134,215,0)}
  50%{transform:scale(1.08);box-shadow:0 0 0 8px rgba(99,134,215,.07)}
}
@keyframes stageShimmer{
  0%{transform:translateX(-130%)}
  100%{transform:translateX(430%)}
}
@keyframes stackGrow{
  from{transform:scaleX(0)}
  to{transform:scaleX(1)}
}
@keyframes riskBreath{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-2px)}
}

/* ----- Escala tipográfica final ----- */
body{font-size:15px;line-height:1.55}
.brand strong{font-size:17px}
.brand span{font-size:11px}
.demo-pill{font-size:11px}
.tab{font-size:14px;min-height:52px}
.page-head h1{font-size:clamp(28px,2.1vw,32px)}
.page-head p{font-size:14px;line-height:1.68}
.filter,.btn{font-size:13px;min-height:44px}
.panel{padding:18px}
.panel-title h3{font-size:16px}
.panel-title p{font-size:12.5px;line-height:1.55}
.panel-action{font-size:12px;min-height:36px;padding:0 4px}
.hero-kicker{font-size:11px}
.hero h2{font-size:clamp(26px,2vw,30px)}
.hero p{font-size:14px}
.hero-chip{font-size:11px}

/* KPIs */
.kpi{min-height:132px;padding:16px}
.kpi-label{font-size:12px}
.kpi strong{font-size:29px}
.kpi small{font-size:11.5px}
.kpi-icon{width:33px;height:33px;font-size:14px}

/* Gráficos e listas */
.bar-row{grid-template-columns:82px 1fr 44px}
.bar-row label,.bar-row strong{font-size:11.5px}
.chart-label{font-size:11px}
.donut-center span{font-size:11px}
.d-row{font-size:11.5px}
.row-title b{font-size:13px}
.row-title span{font-size:11px}
.status{font-size:11px;min-height:28px}
.progress span{font-size:11px}

/* Kanban */
.kanban-col{min-width:282px}
.col-head strong{font-size:13px}
.count{font-size:11px}
.kanban-card{min-height:192px;padding:16px;animation:cardRevealV6 .45s var(--ease) both}
.kanban-card:nth-child(2){animation-delay:.05s}
.kanban-card:nth-child(3){animation-delay:.10s}
.kanban-card:nth-child(4){animation-delay:.15s}
.task-key{font-size:11px}
.kanban-card h4{font-size:14px}
.kanban-card p{font-size:12px}
.tag{font-size:10.5px}
.due{font-size:11px}
.mobile-stage{font-size:13px}

/* Etapa do Kanban com brilho discreto, reforçando o fluxo */
.kanban-col::after{
  content:"";
  position:absolute;
  left:0;top:0;
  width:28%;height:5px;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.9),transparent);
  animation:stageShimmer 5.8s ease-in-out infinite;
  pointer-events:none;
}
.kanban-col:nth-child(2)::after{animation-delay:-1.1s}
.kanban-col:nth-child(3)::after{animation-delay:-2.2s}
.kanban-col:nth-child(4)::after{animation-delay:-3.3s}
.kanban-col:nth-child(5)::after{animation-delay:-4.4s}

/* Áreas */
.summary-card span{font-size:11.5px}
.summary-card strong{font-size:26px}
.area-card{
  min-height:195px;
  cursor:default;
  animation:cardRevealV6 .5s var(--ease) both;
}
.area-card:nth-child(2){animation-delay:.04s}
.area-card:nth-child(3){animation-delay:.08s}
.area-card:nth-child(4){animation-delay:.12s}
.area-card:nth-child(5){animation-delay:.16s}
.area-card:nth-child(6){animation-delay:.20s}
.area-card:nth-child(7){animation-delay:.24s}
.area-card:nth-child(8){animation-delay:.28s}
.area-card:nth-child(9){animation-delay:.32s}
.area-card:nth-child(10){animation-delay:.36s}
.area-card h3{font-size:14px}
.area-card p{font-size:11.5px}
.area-total span{font-size:11px}
.area-status strong{font-size:12px}
.area-status span{font-size:10px}
.stackbar i{
  transform-origin:left;
  animation:stackGrow .8s var(--ease) backwards;
}
.stackbar i:nth-child(2){animation-delay:.1s}
.stackbar i:nth-child(3){animation-delay:.2s}
.rank-row label,.rank-row strong{font-size:11.5px}

/* Indicadores */
.indicator{animation:cardRevealV6 .45s var(--ease) both}
.indicator:nth-child(2){animation-delay:.05s}
.indicator:nth-child(3){animation-delay:.10s}
.indicator:nth-child(4){animation-delay:.15s}
.indicator:nth-child(5){animation-delay:.20s}
.indicator span{font-size:11.5px}
.indicator strong{font-size:27px}
.indicator small{font-size:11px}
.week-col label{font-size:11px}
.squad-row label,.squad-row strong{font-size:11.5px}

/* Riscos */
.risk-summary-card span{font-size:11.5px}
.risk-summary-card strong{font-size:26px}
.risk-intro{font-size:13px}
.risk-card{
  animation:cardRevealV6 .5s var(--ease) both;
}
.risk-card:nth-child(2){animation-delay:.06s}
.risk-card:nth-child(3){animation-delay:.12s}
.risk-card:nth-child(4){animation-delay:.18s}
.risk-card:nth-child(5){animation-delay:.24s}
.risk-card h3{font-size:15px}
.risk-card p{font-size:12.5px}
.risk-badge{font-size:11px}
.risk-block span{font-size:10.5px}
.risk-block strong{font-size:12.5px}
.risk-meta span{font-size:10px}
.risk-meta strong{font-size:11.5px}
.action-progress-head{font-size:11px}
.action-track i{transform-origin:left;animation:stackGrow .9s var(--ease) backwards}

/* Modal Jira */
.task-head .key{font-size:11px}
.task-head h2{font-size:25px}
.modal-action{font-size:12px}
.jira-section h3{font-size:14px}
.jira-section p{font-size:13.5px}
.check-item,.criteria-list li{font-size:13px}
.comment-body strong{font-size:12.5px}
.comment-body time{font-size:10.5px}
.comment-body p{font-size:13px}
.comment-input{font-size:13px}
.comment-submit{font-size:12px}
.side-section h3{font-size:13px}
.detail-row span,.detail-row label{font-size:11px}
.detail-row strong{font-size:12.5px}
.detail-select{font-size:12.5px}
.priority-chip{font-size:11px}
.label{font-size:10.5px}
.activity-item{font-size:11.5px}

/* ----- Hover mais claro sem exagero ----- */
.panel,
.kpi,
.indicator,
.summary-card,
.risk-summary-card{
  transition:transform .22s var(--ease),box-shadow .22s var(--ease),border-color .22s;
}
@media(hover:hover){
  .panel:hover{
    border-color:#c2cfdd;
    box-shadow:0 13px 32px rgba(31,48,68,.09);
  }
  .kpi:hover,.indicator:hover,.summary-card:hover,.risk-summary-card:hover{
    transform:translateY(-3px);
    border-color:#becbd9;
    box-shadow:0 14px 34px rgba(31,48,68,.10);
  }
  .area-card:hover{transform:translateY(-3px)}
  .risk-card:hover{transform:translateY(-2px);border-color:#becbd9;box-shadow:0 12px 28px rgba(31,48,68,.09)}
}

/* ----- Visão Geral: fluxo em movimento ----- */
.delivery-flow{
  position:relative;
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:8px;
  margin:0 0 14px;
  padding:15px 17px 13px;
  border:1px solid var(--line);
  border-radius:16px;
  background:linear-gradient(135deg,#f6f9fc,#eef3f8);
  box-shadow:var(--shadow-sm);
  overflow:hidden;
}
.flow-track{
  position:absolute;
  left:7%;right:7%;top:36px;
  height:3px;border-radius:99px;
  background:repeating-linear-gradient(90deg,#8ca6d9 0 12px,#8ebfbd 12px 22px,transparent 22px 30px);
  background-size:42px 3px;
  opacity:.45;
}
.flow-runner{
  position:absolute;
  top:-5px;left:2%;
  width:13px;height:13px;border-radius:50%;
  background:#fff;
  border:3px solid var(--blue-deep);
  box-shadow:0 0 0 6px rgba(99,134,215,.08);
  animation:flowTravel 6.5s var(--ease) infinite;
}
.flow-step{
  position:relative;z-index:2;
  text-align:center;
  display:grid;justify-items:center;
}
.flow-icon{
  width:44px;height:44px;border-radius:14px;
  display:grid;place-items:center;
  margin-bottom:8px;
  background:#fff;
  border:1px solid var(--line);
  color:var(--blue-deep);
  font-size:16px;font-weight:900;
  box-shadow:0 7px 16px rgba(31,48,68,.06);
  animation:flowGlow 4.5s ease-in-out infinite;
}
.flow-step:nth-child(3) .flow-icon{animation-delay:-.7s}
.flow-step:nth-child(4) .flow-icon{animation-delay:-1.4s}
.flow-step:nth-child(5) .flow-icon{animation-delay:-2.1s}
.flow-step:nth-child(6) .flow-icon{animation-delay:-2.8s}
.flow-step strong{font-size:12px}
.flow-step small{margin-top:2px;color:var(--muted);font-size:10.5px}

/* ----- Áreas: comparação semana x média ----- */
.area-comparison{display:grid;gap:13px}
.compare-row{
  display:grid;
  grid-template-columns:150px 1fr;
  gap:12px;
  align-items:center;
}
.compare-row>label{font-size:12px;font-weight:850;color:#34465b}
.compare-lines{display:grid;gap:5px}
.compare-line{
  display:grid;
  grid-template-columns:78px 1fr 34px;
  gap:7px;
  align-items:center;
}
.compare-line span{font-size:10.5px;color:var(--muted)}
.compare-line strong{font-size:11px;text-align:right}
.compare-track{
  height:10px;border-radius:99px;background:#e4ebf2;overflow:hidden;
}
.compare-track i{
  display:block;height:100%;border-radius:inherit;
  transform-origin:left;
  animation:stackGrow .9s var(--ease) backwards;
}
.compare-current{background:linear-gradient(90deg,var(--blue-deep),var(--teal))}
.compare-average{background:#aebbc9}

/* ----- Riscos: gráfico por área ----- */
.risk-area-chart{display:grid;gap:10px}
.risk-chart-row{
  display:grid;
  grid-template-columns:155px 1fr 36px;
  gap:9px;
  align-items:center;
}
.risk-chart-row label{font-size:12px;font-weight:850;color:#34465b}
.risk-chart-row strong{font-size:11.5px;text-align:right}
.risk-chart-track{
  height:13px;border-radius:99px;background:#e4ebf2;overflow:hidden;
}
.risk-chart-track i{
  display:block;height:100%;border-radius:inherit;
  background:linear-gradient(90deg,var(--amber),var(--rose));
  transform-origin:left;
  animation:stackGrow .8s var(--ease) backwards;
}

/* ----- Acessibilidade extra ----- */
[aria-current="page"]{font-weight:950}
.kanban-card:focus-visible{
  outline:3px solid rgba(62,99,179,.38);
  outline-offset:3px;
  box-shadow:0 0 0 6px rgba(62,99,179,.08),var(--shadow-sm);
}
button:focus-visible,
select:focus-visible,
input:focus-visible{
  outline:3px solid rgba(62,99,179,.34);
  outline-offset:3px;
}

/* Tabela/lista não pode depender apenas de hover para ser legível */
.data-row{min-height:48px}

/* Responsivo */
@media(max-width:900px){
  .delivery-flow{overflow-x:auto;grid-template-columns:repeat(5,minmax(120px,1fr))}
  .flow-track{left:65px;right:65px}
  .compare-row{grid-template-columns:130px 1fr}
}
@media(max-width:650px){
  body{font-size:15px}
  .page-head h1{font-size:25px}
  .page-head p{font-size:14px}
  .panel{padding:15px}
  .panel-title h3{font-size:15px}
  .panel-title p{font-size:12px}
  .kpi strong{font-size:26px}
  .kanban-card h4{font-size:14px}
  .kanban-card p{font-size:12px}
  .area-card h3{font-size:14px}
  .area-card p{font-size:12px}
  .risk-card p,.risk-block strong{font-size:12.5px}
  .compare-row{grid-template-columns:1fr;gap:5px}
  .risk-chart-row{grid-template-columns:115px 1fr 28px}
  .risk-chart-row label{font-size:11px}
  .delivery-flow{padding-inline:11px}
  .flow-step strong{font-size:12px}
  .flow-step small{font-size:11px}
}

/* Se a pessoa preferir menos movimento, tudo novo também para. */
@media(prefers-reduced-motion:reduce){
  .kanban-card,.area-card,.indicator,.risk-card,
  .flow-runner,.flow-icon,.kanban-col::after,
  .stackbar i,.action-track i,.compare-track i,.risk-chart-track i{
    animation:none!important;
  }
}

</style>
</head>

<body>
<a class="skip-link" href="#mainContent">Pular para o conteúdo</a>
<div id="toasts" class="toasts" aria-live="polite"></div>

<div id="taskModalScrim" class="modal-scrim" aria-hidden="true">
  <section id="taskModal" class="task-modal" role="dialog" aria-modal="true" aria-labelledby="modalTaskTitle">
    <div class="task-head">
      <div class="task-head-left"><div id="modalTaskKey" class="key"></div><h2 id="modalTaskTitle">Detalhe da tarefa</h2></div>
      <div class="task-head-actions"><button class="modal-action" id="copyLinkBtn">Copiar referência</button><button class="modal-close" id="taskModalClose" aria-label="Fechar">×</button></div>
    </div>
    <div id="taskModalContent"></div>
  </section>
</div>

<header class="app-header">
  <div class="header-main">
    <div class="brand">
      <div class="brand-mark" aria-hidden="true"><i class="b1"></i><i class="b2"></i><i class="b3"></i></div>
      <div><strong>Data Driven Hub</strong><span>Gestão de demandas e entregas</span></div>
    </div>
    <div class="header-meta">
      <span class="demo-pill"><i></i>Case demonstrativo · dados fictícios</span>
      <button id="notifyBtn" class="icon-btn" aria-label="Notificações">◌</button>
      <div class="avatar" title="Usuário demonstrativo">DD</div>
    </div>
  </div>

  <nav class="tabbar" aria-label="Navegação principal">
    <div class="tabs">
      <button class="tab active" data-route="overview">Visão Geral</button>
      <button class="tab" data-route="kanban">Kanban</button>
      <button class="tab" data-route="areas">Áreas atendidas</button>
      <button class="tab" data-route="indicators">Indicadores</button>
      <button class="tab" data-route="risks">Riscos</button>
    </div>
  </nav>
</header>

<main id="mainContent" tabindex="-1">
<!-- ==================== OVERVIEW ==================== -->
<section class="page active" data-page="overview">
  <div class="page-head">
    <div><h1>Visão geral das demandas e entregas</h1><p>Um resumo simples para acompanhar volume, andamento, atrasos e ritmo de entrega. Todos os números são fictícios e existem apenas para demonstrar o produto.</p></div>
    <div class="page-actions"><button class="btn primary" data-route="kanban">Abrir Kanban →</button></div>
  </div>

  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <span class="hero-kicker">Visão executiva</span>
        <h2>Uma leitura rápida do que entrou, do que está sendo feito e do que foi entregue.</h2>
        <p>O objetivo é dar clareza sobre prioridades, áreas atendidas, prazos e evolução das tarefas sem exigir conhecimento técnico de Dados.</p>
        <div class="hero-chips"><span class="hero-chip">150 tarefas no mês</span><span class="hero-chip">38 nesta semana</span><span class="hero-chip">10 áreas atendidas</span><span class="hero-chip">case fictício</span></div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="stream s1"></div><div class="stream s2"></div>
        <div class="orbit o1"><i></i><i></i></div><div class="orbit o2"><i></i></div>
        <div class="hero-core">↗</div>
      </div>
    </div>
  </section>

  <div class="delivery-flow" aria-label="Fluxo simplificado das tarefas: entrada, a fazer, em andamento, validação e entrega">
    <div class="flow-track" aria-hidden="true"><i class="flow-runner"></i></div>
    <div class="flow-step"><span class="flow-icon">＋</span><strong>Entrada</strong><small>novas solicitações</small></div>
    <div class="flow-step"><span class="flow-icon">○</span><strong>A fazer</strong><small>fila priorizada</small></div>
    <div class="flow-step"><span class="flow-icon">↗</span><strong>Em andamento</strong><small>execução do time</small></div>
    <div class="flow-step"><span class="flow-icon">✓</span><strong>Validação</strong><small>revisão da entrega</small></div>
    <div class="flow-step"><span class="flow-icon">●</span><strong>Entrega</strong><small>concluída</small></div>
  </div>

  <div id="overviewKpis" class="kpi-grid"></div>

  <div class="grid-2">
    <article class="panel">
      <div class="panel-head"><div class="panel-title"><h3>Ritmo de entregas</h3><p>Tarefas planejadas x concluídas por semana</p></div><button class="panel-action" data-route="indicators">Ver indicadores →</button></div>
      <div id="overviewDelivery"></div>
    </article>
    <article class="panel">
      <div class="panel-head"><div class="panel-title"><h3>Situação geral</h3><p>Concluídas, pendentes e atrasadas</p></div></div>
      <div id="overviewDonut"></div>
    </article>
  </div>

  <div class="grid-2 equal">
    <article class="panel">
      <div class="panel-head"><div class="panel-title"><h3>Áreas com maior volume</h3><p>Distribuição das 150 tarefas do mês</p></div><button class="panel-action" data-route="areas">Ver todas →</button></div>
      <div id="topAreas" class="area-ranking"></div>
    </article>
    <article class="panel">
      <div class="panel-head"><div class="panel-title"><h3>Próximas entregas</h3><p>Tarefas fictícias com prazo mais próximo</p></div></div>
      <div id="nextDeliveries" class="data-list"></div>
    </article>
  </div>
</section>

<!-- ==================== KANBAN ==================== -->
<section class="page" data-page="kanban">
  <div class="page-head">
    <div><h1>Kanban de tarefas</h1><p>Um quadro simples de acompanhamento. Clique em qualquer tarefa para abrir uma ficha detalhada inspirada no Jira.</p></div>
    <div class="page-actions">
      <label class="sr-only" for="kanbanAreaFilter">Filtrar Kanban por área</label><select id="kanbanAreaFilter" class="filter" aria-label="Filtrar Kanban por área"></select>
      <button id="addDemoTask" class="btn primary">＋ Tarefa fictícia</button>
    </div>
  </div>
  <div id="kanbanBoard" class="kanban-board"></div>
</section>

<!-- ==================== AREAS ==================== -->
<section class="page" data-page="areas">
  <div class="page-head">
    <div><h1>Áreas atendidas</h1><p>Veja quantas tarefas foram realizadas para cada área, com a divisão entre concluídas, pendentes e atrasadas. Os totais são simulados.</p></div>
    <div class="page-actions">
      <div class="period-switch">
        <button class="period-btn active" data-period="week" aria-pressed="true">Semana</button>
        <button class="period-btn" data-period="month" aria-pressed="false">Mês</button>
      </div>
    </div>
  </div>

  <div id="areaSummary" class="area-summary"></div>

  <article class="panel" style="margin-bottom:12px">
    <div class="panel-head"><div class="panel-title"><h3>Distribuição por área</h3><p id="areaDistributionLabel">38 tarefas na semana</p></div></div>
    <div id="areaGrid" class="area-grid"></div>
  </article>

  <article class="panel comparison-panel" style="margin-bottom:12px">
    <div class="panel-head">
      <div class="panel-title">
        <h3>Semana atual x média semanal do mês</h3>
        <p>Ajuda a identificar quais áreas estão recebendo mais ou menos demandas do que o ritmo médio.</p>
      </div>
    </div>
    <div id="areaComparison" class="area-comparison" role="img" aria-label="Comparação de tarefas da semana atual com a média semanal do mês por área"></div>
  </article>

  <div class="grid-2 equal">
    <article class="panel">
      <div class="panel-head"><div class="panel-title"><h3>Ranking de volume</h3><p>Quem recebeu mais tarefas no período</p></div></div>
      <div id="areaRanking" class="area-ranking"></div>
    </article>
    <article class="panel">
      <div class="panel-head"><div class="panel-title"><h3>Resumo por status</h3><p>Concluídas, pendentes e atrasadas no período</p></div></div>
      <div id="areaStatusDonut"></div>
    </article>
  </div>
</section>

<!-- ==================== INDICATORS ==================== -->
<section class="page" data-page="indicators">
  <div class="page-head">
    <div><h1>Indicadores de entrega</h1><p>Poucos indicadores, com nomes diretos, para acompanhar volume, prazo, produtividade e distribuição do trabalho.</p></div>
    <div class="page-actions"><label class="sr-only" for="indicatorPeriod">Período dos indicadores</label><select id="indicatorPeriod" class="filter" aria-label="Período dos indicadores"><option>Mês atual</option><option>Últimos 3 meses</option><option>Trimestre</option></select></div>
  </div>

  <div id="indicatorGrid" class="indicator-grid"></div>

  <div class="grid-2">
    <article class="panel">
      <div class="panel-head"><div class="panel-title"><h3>Tarefas por semana</h3><p>Planejadas x concluídas</p></div></div>
      <div id="weekBars"></div>
    </article>
    <article class="panel">
      <div class="panel-head"><div class="panel-title"><h3>Volume por squad</h3><p>Distribuição das tarefas entre os times fictícios</p></div></div>
      <div id="squadVolume"></div>
    </article>
  </div>

  <div class="grid-2 equal">
    <article class="panel">
      <div class="panel-head"><div class="panel-title"><h3>Evolução de entregas no prazo</h3><p>Percentual ao longo dos últimos 6 meses</p></div></div>
      <div id="onTimeChart"></div>
    </article>
    <article class="panel">
      <div class="panel-head"><div class="panel-title"><h3>Onde estão as pendências</h3><p>Áreas com maior quantidade de itens não concluídos</p></div></div>
      <div id="pendingAreas" class="area-ranking"></div>
    </article>
  </div>
</section>

<!-- ==================== RISKS ==================== -->
<section class="page" data-page="risks">
  <div class="page-head">
    <div><h1>Riscos e pontos de atenção</h1><p>Em vez de uma matriz abstrata, esta tela explica o risco, o impacto e a ação que está sendo tomada.</p></div>
    <div class="page-actions"><label class="sr-only" for="riskFilter">Filtrar riscos por prioridade</label><select id="riskFilter" class="filter" aria-label="Filtrar riscos por prioridade"><option value="all">Todos</option><option value="high">Alta prioridade</option><option value="medium">Média prioridade</option><option value="low">Baixa prioridade</option></select></div>
  </div>

  <div id="riskSummary" class="risk-summary"></div>

  <div class="risk-intro"><strong>Como ler esta tela:</strong> cada item descreve <strong>o que pode acontecer</strong>, <strong>por que isso importa</strong> e <strong>qual ação está em andamento</strong>. A prioridade é apenas um apoio visual para saber onde olhar primeiro.</div>

  <article class="panel risk-chart-panel" style="margin-bottom:12px">
    <div class="panel-head">
      <div class="panel-title">
        <h3>Onde estão concentrados os riscos</h3>
        <p>Quantidade de pontos de atenção por área — o gráfico respeita o filtro de prioridade.</p>
      </div>
    </div>
    <div id="riskAreaChart" class="risk-area-chart" role="img" aria-label="Quantidade de riscos por área"></div>
  </article>

  <div id="riskList" class="risk-list"></div>
</section>
</main>

<script>
/* ==========================================================
   DADOS FICTÍCIOS
   ========================================================== */

const PEOPLE={
  "MC":{name:"Marina Costa",role:"Analista de Dados"},
  "LP":{name:"Lucas Prado",role:"Analista de BI"},
  "AN":{name:"Amanda Nunes",role:"Product Owner"},
  "RF":{name:"Rafael Freitas",role:"Engenheiro de Dados"},
  "CB":{name:"Camila Barros",role:"Analista de Negócios"},
  "GS":{name:"Gabriel Souza",role:"Analista de Dados"},
  "BM":{name:"Bianca Martins",role:"Scrum Master"},
  "FL":{name:"Felipe Lima",role:"Analista de BI"}
};

const AREAS={
  "Comercial":{color:"#5f82d4",soft:"rgba(95,130,212,.12)",icon:"↗"},
  "FP&A":{color:"#8171c8",soft:"rgba(129,113,200,.12)",icon:"ƒ"},
  "Controladoria":{color:"#58a4aa",soft:"rgba(88,164,170,.12)",icon:"✓"},
  "Departamento Pessoal":{color:"#c9788d",soft:"rgba(201,120,141,.12)",icon:"DP"},
  "Dados & BI":{color:"#4f9f82",soft:"rgba(79,159,130,.12)",icon:"DB"},
  "Compras":{color:"#cf9d46",soft:"rgba(207,157,70,.12)",icon:"C"},
  "Marketing":{color:"#8c79cf",soft:"rgba(140,121,207,.12)",icon:"M"},
  "Logística":{color:"#589bb6",soft:"rgba(88,155,182,.12)",icon:"L"},
  "P&D":{color:"#5da683",soft:"rgba(93,166,131,.12)",icon:"P&D"},
  "Customer Experience":{color:"#bb7eab",soft:"rgba(187,126,171,.12)",icon:"CX"}
};

