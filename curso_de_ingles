const STORAGE_KEY='ingles500-progress-v2';
let state={studied:[],best:0};
try{state={...state,...JSON.parse(localStorage.getItem(STORAGE_KEY)||'{}')}}catch(e){}
const studied=new Set(state.studied||[]);
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const norm=s=>(s??'').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
const shuffle=a=>{const b=[...a];for(let i=b.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]]}return b};
function save(){localStorage.setItem(STORAGE_KEY,JSON.stringify({studied:[...studied],best:state.best||0}));updateStats()}
function toast(msg){const t=$('#toast');t.textContent=msg;t.classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>t.classList.remove('show'),1800)}
function speak(text){if(!('speechSynthesis'in window)){toast('Seu navegador não oferece áudio por voz.');return}speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text);u.lang='en-US';u.rate=.78;const voices=speechSynthesis.getVoices();u.voice=voices.find(v=>/^en-(US|GB)/.test(v.lang))||voices.find(v=>v.lang.startsWith('en'))||null;speechSynthesis.speak(u)}
function updateStats(){const n=studied.size;$('#heroStudied').textContent=n;$('#studiedCount').textContent=n;$('#pendingCount').textContent=500-n;$('#navProgress').textContent=`${n} de 500 estudadas`;$('#heroBest').textContent=`${state.best||0}%`}
function setStudied(n,on){on?studied.add(n):studied.delete(n);save();renderWords();if(flashOrder.length)renderFlash()}
$$('.tab').forEach(btn=>btn.addEventListener('click',()=>{$$('.tab').forEach(x=>x.classList.remove('active'));$$('.panel').forEach(x=>x.classList.remove('active'));btn.classList.add('active');$('#'+btn.dataset.panel).classList.add('active');window.scrollTo({top:0,behavior:'smooth'})}));
function filteredWords(){const q=norm($('#search').value),g=$('#groupFilter').value,s=$('#statusFilter').value;return words.filter(w=>(!q||norm(`${w.n} ${w.word} ${w.translation} ${w.pronunciation}`).includes(q))&&(g==='all'||w.group===g)&&(s==='all'||(s==='studied'?studied.has(w.n):!studied.has(w.n))))}
function renderWords(){const list=filteredWords();$('#shownCount').textContent=list.length;$('#wordTable').innerHTML=list.map(w=>`<tr><td class="n-cell">${w.n}</td><td class="word-main">${w.word}</td><td><button class="audio-btn speak" data-word="${w.word}" aria-label="Ouvir ${w.word}">🔊</button></td><td class="pron">${w.pronunciation}</td><td class="translation">${w.translation}</td><td><span class="group">${w.group}</span></td><td><input class="check studied-check" data-n="${w.n}" type="checkbox" ${studied.has(w.n)?'checked':''} aria-label="Marcar ${w.word} como estudada"></td></tr>`).join('')||`<tr><td colspan="7" class="empty">Nenhuma palavra encontrada.</td></tr>`;$('#mobileList').innerHTML=list.map(w=>`<article class="word-card"><div class="word-card-top"><div><span class="n-cell">#${w.n}</span><h3>${w.word}</h3><div class="pron">${w.pronunciation}</div></div><button class="audio-btn speak" data-word="${w.word}">🔊</button></div><div class="translation">${w.translation}</div><span class="group">${w.group}</span><div class="word-card-actions"><span class="hint">Marcar como estudada</span><input class="check studied-check" data-n="${w.n}" type="checkbox" ${studied.has(w.n)?'checked':''}></div></article>`).join('')||'<div class="empty">Nenhuma palavra encontrada.</div>';$$('.speak').forEach(b=>b.onclick=e=>{e.stopPropagation();speak(b.dataset.word)});$$('.studied-check').forEach(c=>c.onchange=()=>setStudied(+c.dataset.n,c.checked))}
['input','change'].forEach(ev=>$('#search').addEventListener(ev,renderWords));$('#groupFilter').onchange=renderWords;$('#statusFilter').onchange=renderWords;$('#clearFilters').onclick=()=>{$('#search').value='';$('#groupFilter').value='all';$('#statusFilter').value='all';renderWords()};
let flashOrder=[...words],flashIndex=0;
function renderFlash(){const w=flashOrder[flashIndex];$('#flashCard').classList.remove('flipped');$('#flashPosition').textContent=`${flashIndex+1} de ${flashOrder.length}`;$('#flashGroup').textContent=w.group;$('#flashProgress').style.width=`${(flashIndex+1)/flashOrder.length*100}%`;$('#flashWord').textContent=w.word;$('#flashPron').textContent=w.pronunciation;$('#flashTranslation').textContent=w.translation;$('#flashBackWord').textContent=`${w.word} • ${w.pronunciation}`;$('#flashMark').textContent=studied.has(w.n)?'✓ Já estudada':'✓ Marcar como estudada'}
$('#flashCard').onclick=()=>$('#flashCard').classList.toggle('flipped');$('#flashCard').onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();$('#flashCard').click()}};$('#flashAudio').onclick=e=>{e.stopPropagation();speak(flashOrder[flashIndex].word)};$('#flashNext').onclick=()=>{flashIndex=(flashIndex+1)%flashOrder.length;renderFlash()};$('#flashPrev').onclick=()=>{flashIndex=(flashIndex-1+flashOrder.length)%flashOrder.length;renderFlash()};$('#flashShuffle').onclick=()=>{flashOrder=shuffle(words);flashIndex=0;renderFlash();toast('Flashcards embaralhados!')};$('#flashMark').onclick=()=>{const w=flashOrder[flashIndex];setStudied(w.n,!studied.has(w.n));toast(studied.has(w.n)?'Marcada como estudada':'Marca removida')};
let quiz={items:[],index:0,score:0,locked:false,mistakes:[],direction:'en-pt'};
function quizPool(){const scope=$('#quizScope').value;let pool=words.filter(w=>scope==='all'||(scope==='studied'?studied.has(w.n):!studied.has(w.n)));if(pool.length<4){toast('Esse grupo precisa ter pelo menos 4 palavras.');return []}return pool}
function startQuiz(){const pool=quizPool();if(!pool.length)return;const size=Math.min(+$(`#quizSize`).value,pool.length);quiz={items:shuffle(pool).slice(0,size),index:0,score:0,locked:false,mistakes:[],direction:$('#quizDirection').value};$('#quizSetup').classList.add('hidden');$('#quizResult').classList.add('hidden');$('#quizGame').classList.remove('hidden');renderQuestion()}
function currentDirection(){if(quiz.direction==='mixed')return Math.random()<.5?'en-pt':'pt-en';return quiz.direction}
function renderQuestion(){const w=quiz.items[quiz.index],dir=currentDirection();quiz.currentDir=dir;quiz.locked=false;$('#questionNumber').textContent=`Questão ${quiz.index+1} de ${quiz.items.length}`;$('#scoreText').textContent=`Acertos: ${quiz.score}`;$('#quizProgress').style.width=`${quiz.index/quiz.items.length*100}%`;$('#feedback').className='feedback';$('#feedback').textContent='';$('#checkAnswer').classList.remove('hidden');$('#nextQuestion').classList.add('hidden');$('#questionAudio').classList.toggle('hidden',dir==='pt-en');$('#questionLabel').textContent=dir==='en-pt'?'Qual é o significado de:':'Qual palavra em inglês significa:';$('#questionText').textContent=dir==='en-pt'?w.word:w.translation;$('#questionPron').textContent=dir==='en-pt'?w.pronunciation:'';const field=dir==='en-pt'?'translation':'word';const distractors=shuffle(words.filter(x=>x.n!==w.n&&x[field]!==w[field])).slice(0,3);const options=shuffle([w,...distractors]);$('#quizOptions').innerHTML=options.map(o=>`<label class="option" data-n="${o.n}"><input type="radio" name="answer" value="${o.n}"><span>${o[field]}</span></label>`).join('')}
$('#questionAudio').onclick=()=>speak(quiz.items[quiz.index].word);
$('#checkAnswer').onclick=()=>{if(quiz.locked)return;const sel=$('input[name=answer]:checked');if(!sel){toast('Escolha uma alternativa.');return}quiz.locked=true;const w=quiz.items[quiz.index],chosen=+sel.value,ok=chosen===w.n;if(ok)quiz.score++;else quiz.mistakes.push(w);$$('#quizOptions .option').forEach(el=>{const n=+el.dataset.n;if(n===w.n)el.classList.add('correct');if(n===chosen&&!ok)el.classList.add('wrong');el.querySelector('input').disabled=true});const f=$('#feedback');f.className=`feedback ${ok?'ok':'bad'}`;f.textContent=ok?`✅ Correto! ${w.word} = ${w.translation}`:`❌ A resposta correta é: ${w.word} = ${w.translation}`;$('#scoreText').textContent=`Acertos: ${quiz.score}`;$('#checkAnswer').classList.add('hidden');$('#nextQuestion').classList.remove('hidden')};
$('#nextQuestion').onclick=()=>{quiz.index++;if(quiz.index>=quiz.items.length)finishQuiz();else renderQuestion()};
function finishQuiz(){const pct=Math.round(quiz.score/quiz.items.length*100);state.best=Math.max(state.best||0,pct);save();$('#quizGame').classList.add('hidden');$('#quizResult').classList.remove('hidden');$('#finalScore').textContent=`${pct}%`;$('#finalMessage').textContent=pct>=90?'Excelente! Você está dominando esse vocabulário.':pct>=70?'Muito bom! Revise as palavras que errou e tente novamente.':pct>=50?'Bom começo! Mais uma rodada vai ajudar a fixar.':'Vale revisar a lista e usar os flashcards antes da próxima tentativa.';$('#mistakes').innerHTML=quiz.mistakes.length?`<h3>Palavras para revisar</h3>`+quiz.mistakes.map(w=>`<div class="mistake"><strong>${w.word}</strong> <span class="pron">${w.pronunciation}</span><br>${w.translation} <button class="audio-btn" style="float:right" onclick="speak('${w.word.replaceAll("'","\\'")}')">🔊</button></div>`).join(''):'<p>Você não errou nenhuma palavra. Perfeito! 🏆</p>'}
$('#startQuiz').onclick=startQuiz;$('#stopQuiz').onclick=()=>{if(confirm('Encerrar este quiz?')){$('#quizGame').classList.add('hidden');$('#quizSetup').classList.remove('hidden')}};$('#newQuiz').onclick=()=>{$('#quizResult').classList.add('hidden');$('#quizSetup').classList.remove('hidden')};
$('#resetProgress').onclick=()=>{if(confirm('Apagar todas as palavras estudadas e o melhor resultado?')){studied.clear();state.best=0;save();renderWords();renderFlash();toast('Progresso apagado')}};
updateStats();renderWords();renderFlash();if('speechSynthesis' in window) speechSynthesis.getVoices();
</script>
